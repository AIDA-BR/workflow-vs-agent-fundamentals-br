moving averages\\nprice = last['close']\\nrel_mm20 = price - last['MM20']\\nrel_mm50 = price - last['MM50']\\nrel_mm200 = price - last['MM200']\\n\\n# Find recent swing supports/resistances: local minima/maxima in close prices\\n# Simple approach: take recent significant closes and local extrema\\nfrom scipy.signal import argrelextrema\\nimport numpy as np\\n\\ncloses = df['close'].values\\n\\n# find local minima/maxima with order=3 (require 3 neighbors)\\norder = 3\\nif len(closes) > order*2:\\n    minima_idx = argrelextrema(closes, np.less_equal, order=order)[0]\\n    maxima_idx = argrelextrema(closes, np.greater_equal, order=order)[0]\\nelse:\\n    minima_idx = np.array([])\\n    maxima_idx = np.array([])\\n\\n# take last few minima as supports and last maxima as resistances\\nsupports = []\\nresistances = []\\nfor idx in minima_idx[-5:]:\\n    supports.append(float(closes[idx]))\\nfor idx in maxima_idx[-5:]:\\n    resistances.append(float(closes[idx]))\\n\\n# Also include BB_lower and MM200 as supports and MM20/MM50 as resistances\\nsupports_extra = [float(last['BB_lower']), float(last['MM200'])]\\nresistances_extra = [float(last['BB_mid']), float(last['MM50']), float(last['BB_upper'])]\\n\\n# Compose unique sorted lists\\nsupports_all = sorted(set(supports + supports_extra))\\nresistances_all = sorted(set(resistances + resistances_extra))\\n\\n# Pick 3 nearest supports below price and 3 resistances above price\\nsupports_below = [s for s in supports_all if s < price]\\nsupports_nearest = supports_below[-3:] if supports_below else supports_all[:3]\\nresistances_above = [r for r in resistances_all if r > price]\\nresistances_nearest = resistances_above[:4]\\n\\n# Build output\\nmetrics = {\\n    'last_close': float(price),\\n    'MM20': float(last['MM20']),\\n    'MM50': float(last['MM50']),\\n    'MM200': float(last['MM200']),\\n    'EMA9': float(last['EMA9']),\\n    'EMA21': float(last['EMA21']),\\n    'MACD': float(last['MACD']),\\n    'MACD_signal': float(las