ex(drop=True)\\nx = np.arange(n)\\n\\nslope_mm20, intercept_mm20, r_mm20, p_mm20, se_mm20 = stats.linregress(x, sub['MM20'])\\nslope_mm50, intercept_mm50, r_mm50, p_mm50, se_mm50 = stats.linregress(x, sub['MM50'])\\n\\navg_vol_20 = float(sub['volume'].mean())\\nvol_ratio = volume/avg_vol_20\\n\\nbb_width = bb_upper - bb_lower\\nmean_bb_width_20 = float((sub['BB_upper'] - sub['BB_lower']).mean())\\nbb_width_ratio = bb_width/mean_bb_width_20\\n\\nmacd_hist_trend = float(df['MACD_hist'].iloc[-5:].diff().dropna().mean())\\nrsi_trend = float(df['RSI14'].iloc[-5:].diff().dropna().mean())\\n\\noutputs = {\\n    'latest_close': latest_close,\\n    'MM20': mm20,\\n    'MM50': mm50,\\n    'MM200': mm200,\\n    'EMA9': ema9,\\n    'EMA21': ema21,\\n    'MACD': macd,\\n    'MACD_signal': macd_sig,\\n    'MACD_hist': macd_hist,\\n    'BB_lower': bb_lower,\\n    'BB_mid': bb_mid,\\n    'BB_upper': bb_upper,\\n    'RSI14': rsi,\\n    'volume': volume,\\n    'pct_vs_mm20': pct_vs_mm20,\\n    'pct_vs_mm50': pct_vs_mm50,\\n    'pct_vs_mm200': pct_vs_mm200,\\n    'pct_vs_bb_upper': pct_vs_bb_upper,\\n    'pct_vs_bb_mid': pct_vs_bb_mid,\\n    'slope_mm20': slope_mm20,\\n    'slope_mm50': slope_mm50,\\n    'avg_vol_20': avg_vol_20,\\n    'vol_ratio': vol_ratio,\\n    'bb_width': bb_width,\\n    'mean_bb_width_20': mean_bb_width_20,\\n    'bb_width_ratio': bb_width_ratio,\\n    'macd_hist_trend': macd_hist_trend,\\n    'rsi_trend': rsi_trend,\\n}\\n\\nprint(outputs)\\n\"} }",
