id']) / (position['BB_upper'] - position['BB_lower'])\\n\\n# slopes (delta over last 10 trading days)\\nrecent = df.tail(10).copy()\\nslopes = {}\\nfor col in ['MM20','MM50','MM200','EMA9','EMA21']:\\n    slopes[col] = (recent[col].iloc[-1] - recent[col].iloc[0]) / len(recent)\\n\\n# volume comparison\\nvol_mean_20 = df.tail(20)['volume'].mean()\\nvol_mean_50 = df['volume'].tail(50).mean() if len(df)>=50 else df['volume'].mean()\\nposition['vol_mean_20'] = int(vol_mean_20)\\nposition['vol_mean_50'] = int(vol_mean_50)\\nposition['vol_vs_mean20'] = position['volume'] / vol_mean_20\\n\\n# find recent swing highs/lows as potential R/S\\n# Using simple method: local maxima in 'high' column, local minima in 'low' column\\nlevels = []\\nfor i in range(2, len(df)-2):\\n    high = df.loc[i,'high']\\n    if high > df.loc[i-2,'high'] and high > df.loc[i-1,'high'] and high > df.loc[i+1,'high'] and high > df.loc[i+2,'high']:\\n        levels.append(('res', df.loc[i,'high'], df.loc[i,'date']))\\n    low = df.loc[i,'low']\\n    if low < df.loc[i-2,'low'] and low < df.loc[i-1,'low'] and low < df.loc[i+1,'low'] and low < df.loc[i+2,'low']:\\n        levels.append(('sup', df.loc[i,'low'], df.loc[i,'date']))\\n\\n# fallback simple levels: recent highs and lows\\nrecent_highs = df.tail(30)['high'].nlargest(5).unique().tolist()\\nrecent_lows = df.tail(30)['low'].nsmallest(5).unique().tolist()\\n\\n# Compose support/resistance list\\nresistances = sorted([round(x,2) for x in recent_highs if not pd.isna(x)])\\nsupports = sorted([round(x,2) for x in recent_lows if not pd.isna(x)])\\n\\noutput = {\\n    'position': position,\\n    'slopes_per_day': {k: float(v) for k,v in slopes.items()},\\n    'vol_stats': {'mean20': int(vol_mean_20), 'mean50': int(vol_mean_50)},\\n    'resistances_auto': resistances,\\n    'supports_auto': supports,\\n    'levels_detected': levels,\\n    'last_row': last_vals\\n}\\n\\nprint(output)\"} }",
