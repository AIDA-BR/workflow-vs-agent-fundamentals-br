 local minima/maxima in close series using simple approach\\nclose = df['close']\\n\\n# find swing highs/lows by comparing to neighbors\\nswing_highs = []\\nswing_lows = []\\nfor i in range(1, len(close)-1):\\n    if close.iloc[i] > close.iloc[i-1] and close.iloc[i] > close.iloc[i+1]:\\n        swing_highs.append((close.index[i].strftime('%Y-%m-%d'), close.iloc[i]))\\n    if close.iloc[i] < close.iloc[i-1] and close.iloc[i] < close.iloc[i+1]:\\n        swing_lows.append((close.index[i].strftime('%Y-%m-%d'), close.iloc[i]))\\n\\n# pick most recent meaningful levels (top 3 highs and lows)\\nrecent_highs = sorted(swing_highs, key=lambda x: x[1], reverse=True)[:5]\\nrecent_lows = sorted(swing_lows, key=lambda x: x[1])[:5]\\n\\n# Also consider round psychological levels near recent closes\\npsych_res = [31.5,31.0,30.8,30.0]\\npsych_sup = [30.0,29.5,29.0,28.5]\\n\\n# Show outputs\\nprint('Last close: {:.2f}'.format(price))\\nprint('MM20: {:.4f}, MM50: {:.4f}, MM200: {:.4f}'.format(mm20, mm50, mm200))\\nprint('EMA9: {:.4f}, EMA21: {:.4f}'.format(ema9, ema21))\\nprint('Price vs MM20: {:.2f}%'.format(pct_vs_mm20))\\nprint('Price vs MM50: {:.2f}%'.format(pct_vs_mm50))\\nprint('Price vs MM200: {:.2f}%'.format(pct_vs_mm200))\\nprint('Distance to BB upper: {:.2f}% of upper'.format(pct_vs_bb_upper))\\nprint('BB width: {:.4f}'.format(bb_upper - bb_lower))\\nprint('RSI14: {:.2f}'.format(rsi))\\nprint('MACD: {:.4f}, Signal: {:.4f}, Hist: {:.4f}'.format(macd, macd_sig, macd_hist))\\nprint('MACD hist recent mean pct change (last5): {:.4f}'.format(macd_hist_change))\\nprint('EMA9-Price: {:.4f}'.format(ema9-price))\\nprint('Volume last: {}, avg20: {:.0f}, ratio: {:.2f}'.format(int(vol), vol_avg20, vol_ratio))\\nprint('\\\\nRecent swing highs (date, price):', recent_highs[:5])\\nprint('Recent swing lows (date, price):', recent_lows[:5])\\n\\n# prepare numeric levels for support/resistance suggestions\\n# Use recent significant closes: local highs from Nov-Dec and lows from Oct-Nov\\nlevels_res = [31.51,31.379,31.19,31.07,30.82,30.67]  # derived from data points\\nlevels_sup = [30.0,29.47,29.15,28.99,28.71,28.37]\\n\\nprint('\\\\nSuggested resistance levels:', levels_res[:3])\\nprint('Suggested support levels:', levels_sup[:3])\\n\\n# Provide a small summary dictionary for assistant\\nsummary = {\\n    'price': price,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'mm200': mm200,\\n    'ema9': ema9,\\n    'ema21': ema21,\\n    'macd': macd,\\n    'macd_signal': macd_sig,\\n    'macd_hist': macd_hist,\\n    'rsi': rsi,\\n    'bb_lower': bb_lower,\\n    'bb_mid': bb_mid,\\n    'bb_upper': bb_upper,\\n    'vol': int(vol),\\n    'vol_avg20': int(vol_avg20),\\n    'vol_ratio': vol_ratio,\\n    'pct_vs_mm20': pct_vs_mm20,\\n    'pct_vs_mm50': pct_vs_mm50,\\n    'pct_vs_mm200': pct_vs_mm200,\\n    'pct_vs_bb_upper': pct_vs_bb_upper,\\n    'bb_width': bb_upper - bb_lower,\\n    'mm20_slope': mm20_slope,\\n    'mm50_slope': mm50_slope,\\n    'macd_hist_change': macd_hist_change,\\n    'rsi_change_5': rsi_change_5,\\n    'recent_highs': recent_highs[:5],\\n    'recent_lows': recent_lows[:5],\\n    'suggested_resistances': levels_res[:3],\\n    'suggested_supports': levels_sup[:3]\\n}\\n\\nimport json\\nprint('\\\\nJSON-SUMMARY:\\\\n' + json.dumps(summary, indent=2))\\n\"}}",
