 return float('nan')\\n    x2 = x[mask]\\n    y2 = y[mask]\\n    A = np.vstack([x2, np.ones_like(x2)]).T\\n    m, c = np.linalg.lstsq(A, y2, rcond=None)[0]\\n    return float(m)\\n\\nmm20_vals = [r['MM20'] for r in last_n(rows, 10)]\\nmm50_vals = [r['MM50'] for r in last_n(rows, 20)]\\nmm20_slope = slope_linear(mm20_vals)\\nmm50_slope = slope_linear(mm50_vals)\\n\\n# MACD histogram trend last 5 days\\nmacd_hist_5 = [r['MACD_hist'] for r in last_n(rows, 5)]\\nmacd_hist_neg_days = sum(1 for v in macd_hist_5 if v < 0)\\n\\n# Distance price to MM20 and MM50 (pct)\\nprice = rows[-1]['close']\\nmm20 = rows[-1]['MM20']\\nmm50 = rows[-1]['MM50']\\n\\ndist_mm20 = (price - mm20) / mm20 * 100\\ndist_mm50 = (price - mm50) / mm50 * 100\\n\\ndata_out = {\\n    'avg_vol_20': avg_vol_20,\\n    'vol_0305': vol_0305,\\n    'vol_ratio': vol_ratio,\\n    'mm20_slope_per_day_last10': mm20_slope,\\n    'mm50_slope_per_day_last20': mm50_slope,\\n    'macd_hist_5_neg_days': macd_hist_neg_days,\\n    'price': price,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'dist_mm20_pct': dist_mm20,\\n    'dist_mm50_pct': dist_mm50,\\n}\\n\\nprint(data_out)\"} }",
