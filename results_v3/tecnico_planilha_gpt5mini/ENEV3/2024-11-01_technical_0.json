pe:.6f}')\\n\\n# average volume last 10 and last 30\\navg_vol_10 = df['volume'].tail(10).mean()\\navg_vol_20 = df['volume'].tail(20).mean()\\nprint('\\\\nSummary metrics:')\\nprint(f\\\"last_close = {last['close']}\\\")\\nprint(f\\\"MM20 = {last['MM20']}, MM50 = {last['MM50']}, MM200 = {last['MM200']}\\\")\\nprint(f\\\"EMA9 = {last['EMA9']}, EMA21 = {last['EMA21']}\\\")\\nprint(f\\\"MACD = {last['MACD']}, MACD_signal = {last['MACD_signal']}, MACD_hist = {last['MACD_hist']}\\\")\\nprint(f\\\"BB_lower = {last['BB_lower']}, BB_mid = {last['BB_mid']}, BB_upper = {last['BB_upper']}\\\")\\nprint(f\\\"RSI14 = {last['RSI14']}\\\")\\nprint(f\\\"pct_price_mm20 = {pct_price_mm20:.2f}%\\\")\\nprint(f\\\"pct_price_mm50 = {pct_price_mm50:.2f}%\\\")\\nprint(f\\\"pct_price_mm200 = {pct_price_mm200:.2f}%\\\")\\nprint(f\\\"pct_price_bb_lower = {pct_price_bb_lower:.2f}%\\\")\\nprint(f\\\"volume last = {int(last['volume'])}\\\")\\nprint(f\\\"avg_vol_10 = {int(avg_vol_10)}, avg_vol_20 = {int(avg_vol_20)}\\\")\\n\\n# find recent swing lows (local minima) in 'low' column\\nlows = df[['date','low']].sort_values('low').head(5)\\nprint('\\\\nLowest recent lows (sorted):')\\nprint(lows.to_string(index=False))\\n\\n# detect MA relationships\\nprint('\\\\nMA relationships (last row):')\\nprint('price < MM20?', last['close'] < last['MM20'])\\nprint('price < MM50?', last['close'] < last['MM50'])\\nprint('price < MM200?', last['close'] < last['MM200'])\\nprint('MM20 < MM50?', last['MM20'] < last['MM50'])\\nprint('MM50 > MM200?', last['MM50'] > last['MM200'])\\n\\n# MACD recent trend: print last 5 MACD values\\nprint('\\\\nlast 6 MACD values:')\\nprint(df[['date','MACD','MACD_signal','MACD_hist']].tail(6).to_string(index=False))\\n\\n# RSI last 6\\nprint('\\\\nlast 6 RSI values:')\\nprint(df[['date','RSI14']].tail(6).to_string(index=False))\\n\\n# print recent closes\\nprint('\\\\nlast 10 closes:')\\nprint(df[['date','close','volume']].tail(10).to_string(index=False))\\n\\n# print bb lower vs close