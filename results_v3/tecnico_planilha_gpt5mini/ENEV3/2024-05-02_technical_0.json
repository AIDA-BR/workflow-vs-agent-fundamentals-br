mport StringIO\\n\\ndf = pd.read_csv(StringIO(data), sep='\\\\s+', header=0, names=cols, parse_dates=['date'])\\n\\ndf.set_index('date', inplace=True)\\n\\nlast = df.iloc[-1]\\n\\n# compute distances\\nprice = last['close']\\nmm20 = last['MM20']\\nmm50 = last['MM50']\\nmm200 = last['MM200']\\nema9 = last['EMA9']\\nema21 = last['EMA21']\\nmacd = last['MACD']\\nmacd_sig = last['MACD_signal']\\nmacd_hist = last['MACD_hist']\\nrsi = last['RSI14']\\nbb_lower = last['BB_lower']\\nbb_mid = last['BB_mid']\\nbb_upper = last['BB_upper']\\nvol = last['volume']\\n\\n# Percent distances\\ndef pct(a,b):\\n    return (a-b)/b*100\\n\\ndists = {\\n    'price_mm20_pct': pct(price, mm20),\\n    'price_mm50_pct': pct(price, mm50),\\n    'price_mm200_pct': pct(price, mm200),\\n    'price_ema9_pct': pct(price, ema9),\\n    'price_ema21_pct': pct(price, ema21)\\n}\\n\\n# slopes for MM20 and MM50 over last 20 trading days (difference per day)\\nlast20 = df.tail(20)\\nmm20_slope = (last20['MM20'].iloc[-1] - last20['MM20'].iloc[0]) / (len(last20)-1)\\nmm50_slope = (last20['MM50'].iloc[-1] - last20['MM50'].iloc[0]) / (len(last20)-1)\\n\\n# Bollinger width\\nbb_width = bb_upper - bb_lower\\nbb_rel = bb_width / bb_mid\\n\\n# average volume last 20 days\\navg_vol20 = df['volume'].tail(20).mean()\\nvol_vs_avg = vol / avg_vol20\\n\\n# recent supports/resistances: last 30 days highs and lows\\nlast30 = df.tail(30)\\nrecent_high = last30['close'].max()\\nrecent_low = last30['close'].min()\\n\\n# identify local swing lows (support candidates): find 3 lowest closes in last 60 days\\nlowest = df['close'].nsmallest(5)\\nhighest = df['close'].nlargest(5)\\n\\n# Print important metrics\\nprint(f\\\"price={price}\\\")\\nprint(f\\\"MM20={mm20}, MM50={mm50}, MM200={mm200}, EMA9={ema9}, EMA21={ema21}\\\")\\nprint('percent distances:')\\nfor k,v in dists.items():\\n    print(f\\\"  {k}={v:.2f}%\\\")\\nprint(f\\\"MM20_slope_per_day_last20={mm20_slope:.6f}\\\")\\nprint(f\\\"MM50_slope_per_day_last20={mm50_slope:.6f}\\\")\\nprint(f\\\"MACD={macd}, MACD_signal={macd_sig}, MACD_hist={macd_hist}\\\")\\nprint(f\\\"RSI={rsi}\\\")\\nprint(f\\\"BB_width={bb_width:.4f}, BB_rel={bb_rel:.4f}\\\")\\nprint(f\\\"volume_last={vol}, avg_vol20={avg_vol20:.0f}, vol_vs_avg={vol_vs_avg:.2f}\\\")\\nprint(f\\\"recent_high_last30={recent_high}, recent_low_last30={recent_low}\\\")\\nprint('lowest_closes:')\\nprint(lowest.to_string())\\nprint('highest_closes:')\\nprint(highest.to_string())\\n\\n# Prepare support/resistance levels suggestions\\nsupports = [round(x,3) for x in sorted([recent_low, mm200, 12.38, 12.15, 12.05])] # include some observed\\nresistances = [round(x,3) for x in sorted([recent_high, mm20, mm50, 13.1231, 12.83], reverse=True)]\\nprint('supports:', supports)\\nprint('resistances:', resistances)\\n\\n# Output a short summary for use in report\\nsummary = {\\n    'price': price,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'mm200': mm200,\\n    'ema9': ema9,\\n    'ema21': ema21,\\n    'macd': macd,\\n    'macd_sig': macd_sig,\\n    'macd_hist': macd_hist,\\n    'rsi': rsi,\\n    'bb_width': bb_width,\\n    'bb_rel': bb_rel,\\n    'vol': vol,\\n    'avg_vol20': avg_vol20,\\n    'vol_vs_avg': vol_vs_avg,\\n    'mm20_slope': mm20_slope,\\n    'mm50_slope': mm50_slope,\\n    'supports': supports,\\n    'resistances': resistances\\n}\\nimport json\\nprint(json.dumps(summary))\\n\"} }",
