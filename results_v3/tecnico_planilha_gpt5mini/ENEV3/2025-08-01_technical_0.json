inima/maxima in last 60 days\\nfrom scipy.signal import argrelextrema\\n\\ncloses = df['close']\\n# numeric array\\narr = closes.values\\n# find local minima/maxima using order=3\\norder = 3\\nmin_idx = argrelextrema(arr, np.less_equal, order=order)[0]\\nmax_idx = argrelextrema(arr, np.greater_equal, order=order)[0]\\n\\n# take last significant minima and maxima\\nmin_vals = sorted(list(set(arr[min_idx].tolist())))\\nmax_vals = sorted(list(set(arr[max_idx].tolist())), reverse=True)\\n\\n# Also consider absolute recent lows/highs\\nrecent_low = df['low'].tail(30).min()\\nrecent_high = df['high'].tail(30).max()\\n\\n# Compose support/resistance candidates\\nsupports = []\\nresistances = []\\n\\n# Add recent local minima close prices\\nfor i in min_idx:\\n    supports.append(arr[i])\\n\\n# Add absolute recent lows\\nsupports.append(recent_low)\\n# Add MM200 as structural support\\nsupports.append(last['MM200'])\\n\\n# Resistances: local maxima closes and recent highs, and BB_upper\\nfor i in max_idx:\\n    resistances.append(arr[i])\\nresistances.append(recent_high)\\nresistances.append(last['BB_upper'])\\nresistances.append(last['MM50'])\\n\\n# Deduplicate and sort\\nsupports = sorted(list(set([round(float(x),2) for x in supports])))\\nresistances = sorted(list(set([round(float(x),2) for x in resistances])), reverse=True)\\n\\n# Clip top 4 each\\nsupports_sorted = supports[:4]\\nresistances_sorted = resistances[:4]\\n\\n# Volume trend: average volume last 5 vs avg last 30\\nvol_avg_5 = df['volume'].tail(5).mean()\\nvol_avg_30 = df['volume'].tail(30).mean()\\nvol_trend = 'decrescente' if vol_avg_5 < vol_avg_30 else 'crescente'\\n\\n# Compose output info\\ninfo = {\\n    'price': price,\\n    'MM20': last['MM20'],\\n    'MM50': last['MM50'],\\n    'MM200': last['MM200'],\\n    'EMA9': last['EMA9'],\\n    'EMA21': last['EMA21'],\\n    'MACD': last['MACD'],\\n    'MACD_signal': last['MACD_signal'],\\n    'MACD_hist': last['MACD_hist'],\\n    'RSI14': last['RSI14'],\\n    