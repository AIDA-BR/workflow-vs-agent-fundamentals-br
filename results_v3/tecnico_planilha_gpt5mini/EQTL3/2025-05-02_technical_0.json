0 = df['MACD'].iloc[-11]\\nmacd_diff_10 = macd - macd_10\\n\\n# Prepare results\\nresults = {\\n    'price': price,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'mm200': mm200,\\n    'ema9': ema9,\\n    'ema21': ema21,\\n    'ema_diff': ema_diff,\\n    'macd': macd,\\n    'macd_signal': macd_signal,\\n    'macd_hist': macd_hist,\\n    'macd_diff_10': macd_diff_10,\\n    'bb_lower': bb_lower,\\n    'bb_mid': bb_mid,\\n    'bb_upper': bb_upper,\\n    'bb_pos': pos_bb,\\n    'rsi': rsi,\\n    'volume': vol,\\n    'avg_vol_20': avg_vol_20,\\n    'vol_vs_avg20': vol_vs_avg20,\\n    'pct_vs_mm20': pct_vs_mm20,\\n    'pct_vs_mm50': pct_vs_mm50,\\n    'pct_vs_mm200': pct_vs_mm200,\\n    'mm20_change_since_0402': mm20_change,\\n    'mm20_pct_change_since_0402': mm20_pct_change\\n}\\n\\nprint(results)\"} }",
