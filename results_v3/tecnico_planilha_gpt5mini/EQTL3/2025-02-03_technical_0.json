gn change (cross above)\\nmacd_cross_up = None\\nfor i in range(1,len(df)):\\n    if df['MACD'].iloc[i] > df['MACD_signal'].iloc[i] and df['MACD'].iloc[i-1] <= df['MACD_signal'].iloc[i-1]:\\n        macd_cross_up = df['date'].iloc[i]\\n\\n# bollinger width\\ndf['bb_width'] = df['BB_upper'] - df['BB_lower']\\nbb_width_last = df['bb_width'].iloc[-1]\\nbb_width_avg10 = df['bb_width'].iloc[-10:].mean()\\n\\n# rsi trend last 10 days delta\\nrsi_delta_10 = df['RSI14'].iloc[-1] - df['RSI14'].iloc[-10]\\n\\n# moving average order\\nmm_order = (df['MM20'].iloc[-1], df['MM50'].iloc[-1], df['MM200'].iloc[-1])\\n\\n# distances\\ndist_to_mm50 = last['close'] - last['MM50']\\ndist_to_mm200 = last['close'] - last['MM200']\\ndist_to_bb_upper = last['BB_upper'] - last['close']\\n\\n# identify local recent resistances and supports using simple pivot detection on close\\n\\nfrom scipy.signal import argrelextrema\\nimport numpy as np\\n\\ncl = df['close'].values\\n# find local maxima and minima with order=3\\norder = 3\\nlocal_max_idx = argrelextrema(cl, np.greater_equal, order=order)[0]\\nlocal_min_idx = argrelextrema(cl, np.less_equal, order=order)[0]\\n\\nrecent_res = []\\nrecent_sup = []\\n# collect last few\\nfor i in local_max_idx:\\n    recent_res.append((df['date'].iloc[i], df['close'].iloc[i]))\\nfor i in local_min_idx:\\n    recent_sup.append((df['date'].iloc[i], df['close'].iloc[i]))\\n\\n# sort by date descending\\nrecent_res_sorted = sorted(recent_res, key=lambda x: x[0], reverse=True)\\nrecent_sup_sorted = sorted(recent_sup, key=lambda x: x[0], reverse=True)\\n\\noutput = {\\n    'last_close': float(last['close']),\\n    'MM20': float(last['MM20']),\\n    'MM50': float(last['MM50']),\\n    'MM200': float(last['MM200']),\\n    'EMA9': float(last['EMA9']),\\n    'EMA21': float(last['EMA21']),\\n    'MACD': float(last['MACD']),\\n    'MACD_signal': float(last['MACD_signal']),\\n    'MACD_hist': float(last['MACD_hist']),\\n    'BB_lower': float(last['BB_lower']),\\n    'BB_mid': float(last['BB_mid']),\\n    'BB_upper': float(last['BB_upper']),\\n    'RSI14': float(last['RSI14']),\\n    'volume_last': float(last['volume']),\\n    'avg_vol_20': float(avg_vol_20),\\n    'vol_ratio': float(vol_ratio),\\n    'mm20_slope_10d': float(mm20_slope) if mm20_slope is not None else None,\\n    'ema_cross_up': str(ema_cross_up) if ema_cross_up is not None else None,\\n    'macd_cross_up': str(macd_cross_up) if macd_cross_up is not None else None,\\n    'bb_width_last': float(bb_width_last),\\n    'bb_width_avg10': float(bb_width_avg10),\\n    'rsi_delta_10': float(rsi_delta_10),\\n    'mm_order': mm_order,\\n    'dist_to_mm50': float(dist_to_mm50),\\n    'dist_to_mm200': float(dist_to_mm200),\\n    'dist_to_bb_upper': float(dist_to_bb_upper),\\n    'recent_res': recent_res_sorted[:5],\\n    'recent_sup': recent_sup_sorted[:5]\\n}\\n\\nprint(output)\\n\"} }",
