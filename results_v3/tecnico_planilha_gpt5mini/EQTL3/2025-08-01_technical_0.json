263,-0.5138,-0.4603,-0.0535,33.1707,34.691,36.2113,35.4022\\n2025-07-29,33.49,34.1,33.16,33.77,15761795500,34.573,35.6408,32.6006,34.06,34.5485,-0.5154,-0.4713,-0.044,33.1604,34.573,35.9856,39.0763\\n2025-07-30,33.5,34.96,33.5,34.53,25250016300,34.53,35.5852,32.6122,34.154,34.5468,-0.4501,-0.4671,0.017,33.1708,34.53,35.8892,48.0357\\n2025-07-31,34.19,34.36,33.75,34.07,18902730600,34.4305,35.5406,32.6185,34.1372,34.5034,-0.4306,-0.4598,0.0292,33.2654,34.4305,35.5956,43.834\\n2025-08-01,34.33,35.05,34.08,34.33,20708965800,34.3435,35.5044,32.6279,34.1758,34.4877,-0.3896,-0.4458,0.0562,33.4707,34.3435,35.2163,46.6733\\n\\\"\\\"\\\"\\n\\n# Read into DataFrame\\ndf = pd.read_csv(StringIO(data), parse_dates=['date'])\\n\\n# Basic last values\\nlast = df.iloc[-1]\\n\\n# Compute signs and distances\\nprice = last['close']\\nmm20 = last['MM20']\\nmm50 = last['MM50']\\nmm200 = last['MM200']\\nema9 = last['EMA9']\\nema21 = last['EMA21']\\nmacd = last['MACD']\\nmacd_signal = last['MACD_signal']\\nmacd_hist = last['MACD_hist']\\nrsi = last['RSI14']\\nbb_lower= last['BB_lower']\\nbb_mid = last['BB_mid']\\nbb_upper = last['BB_upper']\\nvol = last['volume']\\n\\n# Distances\\ndist_mm20 = price - mm20\\ndist_mm50 = price - mm50\\ndist_mm200 = price - mm200\\npct_mm20 = dist_mm20 / mm20 * 100\\npct_mm50 = dist_mm50 / mm50 * 100\\npct_mm200 = dist_mm200 / mm200 * 100\\n\\n# Slope of moving averages (simple diff over last 5 and 20 days)\\nfor span in [5,10,20]:\\n    df[f'slope_MM20_{span}'] = (df['MM20'] - df['MM20'].shift(span)) / span\\n    df[f'slope_MM50_{span}'] = (df['MM50'] - df['MM50'].shift(span)) / span\\n    df[f'slope_MM200_{span}'] = (df['MM200'] - df['MM200'].shift(span)) / span\\n\\nslopes = { 'MM20_5': df['slope_MM20_5'].iloc[-1], 'MM20_20': df['slope_MM20_20'].iloc[-1],\\n           'MM50_5': df['slope_MM50_5'].iloc[-1], 'MM50_20': df['slope_MM50_20'].iloc[-1],\\n           'MM200_20': df['slope_MM200_20'].iloc[-1] }\\n\\n# MACD crossover recent: find last few MACD_hist sign changes\\nhist = df['MACD_hist']\\nsign_changes = df[hist * hist.shift(1) < 0]\\n\\n# Compute average volume last 20 days\\navg_vol_20 = df['volume'].tail(20).mean()\\nvol_ratio = vol / avg_vol_20\\n\\n# Bollinger band width\\nbb_width = bb_upper - bb_lower\\n\\n# Support/resistance: simple approach: local lows/highs in last 30 days\\nrecent = df.tail(30)\\n\\nsupports = recent['low'].nsmallest(3).unique().tolist()  # be careful\\nresistances = recent['high'].nlargest(3).unique().tolist()\\n\\n# Better pick round levels typical: look at psychologically/technical levels: MM50, MM20, BB_lower, recent lows\\n\\nprint('last_close', price)\\nprint('MM20', mm20, 'MM50', mm50, 'MM200', mm200)\\nprint('EMA9', ema9, 'EMA21', ema21)\\nprint('distances to MAs', round(dist_mm20,4), round(dist_mm50,4), round(dist_mm200,4))\\nprint('pct distances (%)', round(pct_mm20,3), round(pct_mm50,3), round(pct_mm200,3))\\nprint('slopes', slopes)\\nprint('MACD', macd, 'signal', macd_signal, 'hist', macd_hist)\\nprint('MACD sign change dates (hist sign flip):')\\nprint(sign_changes[['date','MACD_hist']])\\nprint('RSI', rsi)\\nprint('BB mid/upper/lower', bb_mid, bb_upper, bb_lower, 'width', round(bb_width,4))\\nprint('volume', vol, 'avg20', int(avg_vol_20), 'ratio', round(vol_ratio,3))\\nprint('supports (3 lowest recent lows)', supports)\\nprint('resistances (3 highest recent highs)', resistances)\\n\\n# Build simple indicator readings for output\\nindicator_readings = [\\n    ('MM20', f'{mm20:.4f}', 'Pre\u00e7o est\u00e1 ~ na MM20 (neutro de curt\u00edssimo prazo)'),\\n    ('MM50', f'{mm50:.4f}', 'Pre\u00e7o abaixo da MM50 (m\u00e9dio prazo em tend\u00eancia de baixa)'),\\n    ('MM200', f'{mm200:.4f}', 'Pre\u00e7o acima da MM200 (tend\u00eancia de longo prazo ainda positiva)'),\\n    ('EMA9', f'{ema9:.4f}', 'Pre\u00e7o acima da EMA9 \u2014 leve vi\u00e9s de curto prazo de alta'),\\n    ('EMA21', f'{ema21:.4f}', 'Pre\u00e7o abaixo da EMA21 \u2014 resist\u00eancia de curto/m\u00e9dio prazo'),\\n    ('MACD', f'{macd:.4f} / signal {macd_signal:.4f} / hist {macd_hist:.4f}', 'MACD acima da linha de sinal; hist positivo pequeno \u2014 momentum em recupera\u00e7\u00e3o'),\\n    ('Bollinger', f'lower {bb_lower:.4f} mid {bb_mid:.4f} upper {bb_upper:.4f}', 'Pre\u00e7o pr\u00f3ximo ao meio da banda; bandas relativamente estreitas \u2014 volatilidade moderada'),\\n    ('RSI14', f'{rsi:.4f}', 'RSI ~46 \u2014 sem sobrecompra/sobrevenda; neutro'),\\n    ('Volume', f'{int(vol)} (\u00faltimo preg\u00e3o)', f'Volume ~{round(vol_ratio,2)}x m\u00e9dia 20 dias \u2014 confirma\u00e7\u00e3o moderada')\\n]\\n\\n# Prepare a dictionary result\\nresult = {\\n    'price': price,\\n    'pct_distances': {'pct_mm20': pct_mm20, 'pct_mm50': pct_mm50, 'pct_mm200': pct_mm200},\\n    'slopes': slopes,\\n    'avg_vol_20': int(avg_vol_20),\\n    'vol_ratio': vol_ratio,\\n    'bb_width': bb_width,\\n    'supports': supports,\\n    'resistances': resistances,\\n    'indicator_readings': indicator_readings\\n}\\n\\nprint('\\\\n---RESULT---')\\nprint(result)\\n\\n# Also print a short summary strings to use in final report\\n\\nsummary = []\\nsummary.append(f\\\"Fechamento em {price} \u2014 posi\u00e7\u00e3o: vs MM20 {round(dist_mm20,3)}, MM50 {round(dist_mm50,3)}, MM200 {round(dist_mm200,3)}\\\")\\nsummary.append(f\\\"MACD hist {macd_hist:.4f} (leve positivo), RSI {rsi:.1f}\\\")\\nsummary.append(f\\\"Bandas BB largura = {bb_width:.4f}; BB mid = {bb_mid:.4f}\\\")\\nsummary.append(f\\\"Volume \u00faltimo preg\u00e3o = {int(vol)}, m\u00e9dia 20 dias = {int(avg_vol_20)}, rela\u00e7\u00e3o = {vol_ratio:.2f}\\\")\\nprint('\\\\n'.join(summary))\\n\\n\\n# Return the result object for further parsing\\nresult\\n\"} }",
