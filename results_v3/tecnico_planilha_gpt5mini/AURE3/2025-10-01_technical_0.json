0.6100,10.2394,9.0857,10.5327,10.5524,0.0431,0.1260,-0.0829,10.0848,10.6100,11.1352,44.6540\\n2025-09-30,10.35,10.45,10.15,10.27,4636394900,10.6175,10.2564,9.0891,10.4802,10.5267,0.0166,0.1041,-0.0875,10.1182,10.6175,11.1168,43.4337\\n2025-10-01,10.23,10.30,10.02,10.08,5767064900,10.6155,10.2636,9.0916,10.4001,10.4861,-0.0194,0.0794,-0.0988,10.1075,10.6155,11.1235,39.0651\\n'''\\n\\ndf = pd.read_csv(StringIO(csv), parse_dates=['date'])\\ndf.set_index('date', inplace=True)\\n\\nlast = df.iloc[-1]\\n\\n# Compute 20-day avg volume (or as many rows if less)\\nvol_avg_20 = df['volume'].tail(20).mean()\\nvol_last = int(last['volume'])\\nvol_ratio = vol_last / vol_avg_20\\n\\n# Count closes below BB_lower in last 20 days\\nbelow_bb = (df['close'].tail(20) < df['BB_lower'].tail(20)).sum()\\n\\n# 20-day close min/max and dates\\nlast_20 = df['close'].tail(20)\\nmin_close = last_20.min()\\nmin_date = last_20.idxmin().date().isoformat()\\nmax_close = last_20.max()\\nmax_date = last_20.idxmax().date().isoformat()\\n\\n# slope of MM20 over last 10 days (linear regression)\\nmm20_recent = df['MM20'].dropna().tail(10)\\nx = np.arange(len(mm20_recent))\\nif len(mm20_recent) >= 2:\\n    slope, intercept, r_value, p_value, std_err = stats.linregress(x, mm20_recent.values)\\n    slope_pct_10 = slope / mm20_recent.values[0] * 100\\nelse:\\n    slope = np.nan\\n    slope_pct_10 = np.nan\\n\\n# MACD histogram recent sign change\\nhist = df['MACD_hist']\\n# find last index where hist was positive then negative\\nhist_sign = np.sign(hist)\\nchanges = ((hist_sign.shift(1) > 0) & (hist_sign <= 0))\\nlast_bear_cross = df[changes].tail(1)\\nlast_bear_cross_date = last_bear_cross.index[0].date().isoformat() if not last_bear_cross.empty else None\\n\\n# EMA relationship\\nema9_last = last['EMA9']\\nema21_last = last['EMA21']\\nema_relation = 'EMA9<EMA21' if ema9_last < ema21_last else 'EMA9>EMA21'\\n\\n# MM relationships\\nmm20_last = last['MM20']\\nmm50_last = last['MM50']\\nmm200_last = last['MM200']\\nmm_relation = 'MM20<MM50' if mm20_last < mm50_last else 'MM20>MM50'\\nmm50_200 = 'MM50>MM200' if mm50_last > mm200_last else 'MM50<MM200'\\n\\n# last 20-day std of close (volatility proxy)\\nvolatility_20 = df['close'].tail(20).std()\\n\\n# recent lows list for supports from last 30 days\\nrecent = df.tail(30)\\n# Identify local minima and maxima using simple method: compare to +/-2 neighbors\\nsupports = []\\nresistances = []\\nfor i in range(2, len(recent)-2):\\n    window = recent['close'].values\\n    if window[i] < window[i-1] and window[i] < window[i+1] and window[i] < window[i-2] and window[i] < window[i+2]:\\n        supports.append(recent['close'].iloc[i])\\n    if window[i] > window[i-1] and window[i] > window[i+1] and window[i] > window[i-2] and window[i] > window[i+2]:\\n        resistances.append(recent['close'].iloc[i])\\n\\n# Add important levels: BB_lower, MM20, EMA9, recent high/low\\nlevels_support = sorted(list(set([round(float(last['low']),4), round(float(df['BB_lower'].iloc[-1]),4), round(float(mm200_last),4), round(float(min_close),4)])))\\nlevels_resistance = sorted(list(set([round(float(ema9_last),4), round(float(mm20_last),4), round(float(df['BB_upper'].iloc[-1]),4), round(float(max_close),4)])))\\n\\n# Prepare output dict\\nout = {\\n    'last_close': float(last['close']),\\n    'last_low': float(last['low']),\\n    'last_high': float(last['high']),\\n    'vol_last': vol_last,\\n    'vol_avg_20': int(vol_avg_20),\\n    'vol_ratio': round(vol_ratio,2),\\n    'below_bb_count_20': int(below_bb),\\n    'min_close_20': float(min_close),\\n    'min_close_20_date': min_date,\\n    'max_close_20': float(max_close),\\n    'max_close_20_date': max_date,\\n    'mm20_slope_per_day': float(slope) if not np.isnan(slope) else None,\\n    'mm20_slope_pct_10': float(slope_pct_10) if not np.isnan(slope_pct_10) else None,\\n    'last_bear_cross_date': last_bear_cross_date,\\n    'ema_relation': ema_relation,\\n    'mm_relation': mm_relation,\\n    'mm50_200': mm50_200,\\n    'volatility_20': float(volatility_20),\\n    'supports_candidates': levels_support,\\n    'resistance_candidates': levels_resistance,\\n}\\n\\nprint(out)\\n\"} }",
