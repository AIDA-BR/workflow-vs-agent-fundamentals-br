ist values\\nmacd_hist = df['MACD_hist']\\nmacd_hist_last5 = macd_hist[-5:].values\\n\\n# Bollinger width recent\\nbb_width = latest['BB_upper'] - latest['BB_lower']\\nbb_width_last10 = df['BB_upper'] - df['BB_lower']\\nbb_width_last10 = bb_width_last10[-10:]\\n\\n# RSI trend\\nrsi_last5 = df['RSI14'][-5:].values\\n\\n# Volume: average volume last 20 days, compare latest\\nvol = df['volume']\\nvol_mean_20 = vol[-20:].mean()\\nvol_latest = latest['volume']\\n\\n# Identify support/resistance: use recent closes and local minima/maxima\\ncl = df['close']\\n# find local minima/maxima using simple window\\nsupports = []\\nresistances = []\\nfor i in range(2, len(cl)-2):\\n    window = cl.iloc[i-2:i+3]\\n    val = cl.iloc[i]\\n    if val == window.min():\\n        supports.append((cl.index[i], val))\\n    if val == window.max():\\n        resistances.append((cl.index[i], val))\\n\\n# Also take absolute minima in last 3 months and recent peaks\\nrecent_period = cl[-60:]\\nabs_min = recent_period.min()\\nabs_max = recent_period.max()\\n\\n# Simplify support/resistance list to numeric levels (unique sorted)\\nsup_levels = sorted(set([round(v,2) for _,v in supports]))\\nres_levels = sorted(set([round(v,2) for _,v in resistances]))\\n\\n# Add obvious clusters: recent lows and highs\\ncandidate_supports = sorted(set([round(abs_min,2), round(cl[-5:].min(),2), round(cl[-10:].min(),2)]))\\ncandidate_resistances = sorted(set([round(abs_max,2), round(cl[-5:].max(),2), round(cl[-10:].max(),2)]))\\n\\n# Prepare output summary\\nsummary = {\\n    'latest_close': float(price),\\n    'pct_to_mm20': float(pct_to_mm20),\\n    'pct_to_mm50': float(pct_to_mm50),\\n    'pct_to_mm200': float(pct_to_mm200),\\n    'ema9': float(ema9),\\n    'ema21': float(ema21),\\n    'macd': float(latest['MACD']),\\n    'macd_signal': float(latest['MACD_signal']),\\n    'macd_hist': float(latest['MACD_hist']),\\n    'macd_hist_last5': macd_hist_last5.tolist(),\\n    'bb_width': float(bb_width),\\n    'bb_width_last10_mean': float(bb_width_last10.mean()),\\n    'rsi': float(latest['RSI14']),\\n    'rsi_last5': rsi_last5.tolist(),\\n    'vol_latest': int(vol_latest),\\n    'vol_mean_20': float(vol_mean_20),\\n    'supports_detected': sup_levels,\\n    'resistances_detected': res_levels,\\n    'candidate_supports': candidate_supports,\\n    'candidate_resistances': candidate_resistances,\\n    'slope_mm20': float(slope_mm20),\\n    'slope_mm50': float(slope_mm50)\\n}\\n\\nimport json\\nprint(json.dumps(summary, indent=2))\\n\"} }",
