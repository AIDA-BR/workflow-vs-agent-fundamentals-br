idx = argrelextrema(prices, np.greater_equal, order=order)[0]\\nmin_idx = argrelextrema(prices, np.less_equal, order=order)[0]\\n# get top 3 maxima and minima values\\nmax_vals = sorted(list(prices[max_idx]) if len(max_idx)>0 else [], reverse=True)[:3]\\nmin_vals = sorted(list(prices[min_idx]) if len(min_idx)>0 else [])[:3]\\n# fallback: use highs and lows\\nif len(max_vals)==0:\\n    max_vals = sorted(df['high'].tail(20).unique())[-3:]\\nif len(min_vals)==0:\\n    min_vals = sorted(df['low'].tail(20).unique())[:3]\\n\\n# also include MA levels as support/resistance candidates\\nsupport_candidates = [round(last['MM20'],4), round(last['MM50'],4), round(min_vals[0] if min_vals else last['close'],4)]\\nresistance_candidates = [round(max_vals[0] if max_vals else last['close'],4), round(last['BB_upper'],4), round(last['MM200'],4)]\\n\\n# compute average volume last 20 days and compare to last\\navg_vol_20 = float(df['volume'].tail(20).mean())\\nvol_last = float(last['volume'])\\nvol_ratio = vol_last/avg_vol_20\\n\\nresult = {\\n    'slopes': slopes,\\n    'alignment': alignment,\\n    'last_cross_date': str(last_cross_date) if last_cross_date is not None else None,\\n    'support_candidates': support_candidates,\\n    'resistance_candidates': resistance_candidates,\\n    'avg_vol_20': avg_vol_20,\\n    'vol_last': vol_last,\\n    'vol_ratio': vol_ratio,\\n    'max_vals': max_vals,\\n    'min_vals': min_vals\\n}\\nprint(result)\\n\"} }",
