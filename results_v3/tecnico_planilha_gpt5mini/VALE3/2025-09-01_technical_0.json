 (metrics['close'] - metrics['BB_lower'])/metrics['BB_mid']*100\\n\\n# MA slopes (difference last - 10 days prior)\\nmetrics['MM20_slope_10d'] = (latest['MM20'] - df.iloc[-11]['MM20'])\\nmetrics['MM50_slope_10d'] = (latest['MM50'] - df.iloc[-11]['MM50'])\\nmetrics['MM200_slope_10d'] = (latest['MM200'] - df.iloc[-11]['MM200'])\\n\\n# volume: compare to 20-day average\\nvol_20 = df['volume'].tail(20).mean()\\nmetrics['vol_20_avg'] = float(vol_20)\\nmetrics['vol_vs_20d'] = metrics['volume']/metrics['vol_20_avg']\\n\\n# Bollinger width and 20-day average width\\nwidths = df['BB_upper'] - df['BB_lower']\\nmetrics['BB_width'] = float(latest['BB_upper'] - latest['BB_lower'])\\nmetrics['BB_width_20d_avg'] = float(widths.tail(20).mean())\\nmetrics['BB_width_vs_20d'] = metrics['BB_width']/metrics['BB_width_20d_avg']\\n\\n# MACD positive days in last 20\\nmetrics['MACD_pos_20d'] = int((df['MACD'].tail(20) > df['MACD_signal'].tail(20)).sum())\\n\\n# recent swing lows/highs for support/resistance candidates\\n# Find local minima and maxima in 'close' using simple method\\nfrom scipy.signal import argrelextrema\\nimport numpy as np\\narr = df['close'].values\\n# compute local minima/maxima\\nlocal_max_idx = argrelextrema(arr, np.greater_equal, order=3)[0]\\nlocal_min_idx = argrelextrema(arr, np.less_equal, order=3)[0]\\n\\nlocal_max = df.iloc[local_max_idx][['date','close','high']]\\nlocal_min = df.iloc[local_min_idx][['date','close','low']]\\n\\nmetrics['local_max'] = local_max.tail(6).to_dict(orient='records')\\nmetrics['local_min'] = local_min.tail(6).to_dict(orient='records')\\n\\n# simple supports/resistances: recent lows and highs\\nsupports = []\\nresistances = []\\n# add BB_mid (MM20) as support\\nsupports.append(round(metrics['MM20'],3))\\n# add recent cluster lows: find minima in Aug and June\\n# pick distinct values\\nmin_candidates = sorted(set([round(x,2) for x in df['close'].where(df['date']>=pd.Timestamp('2025-06-01')).nsmallest(6).values]))\\n# pick lowest three unique\\nfor v in min_candidates[:3]:\\n    supports.append(float(v))\\n# Resistances: BB_upper and recent highs\\nresistances.append(round(metrics['BB_upper'],3))\\n# recent top closes\\nmax_candidates = sorted(set([round(x,2) for x in df['close'].where(df['date']>=pd.Timestamp('2025-06-01')).nlargest(6).values]), reverse=True)\\nfor v in max_candidates[:3]:\\n    resistances.append(float(v))\\n\\nmetrics['supports'] = supports\\nmetrics['resistances'] = resistances\\n\\n# print metrics\\nfor k,v in metrics.items():\\n    print(f\\\"{k}: {v}\\\")\\n\\n# Also produce a short dict for programmatic use\\nmetrics\\n\"} }",
