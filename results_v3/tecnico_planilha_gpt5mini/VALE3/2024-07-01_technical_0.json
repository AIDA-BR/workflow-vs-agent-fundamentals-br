ao \u00faltimo close\\nlast_close = last['close']\\n\\n# extrair \u00faltimas 6 pivot highs and lows\\npivots_high_sorted = sorted(pivots_high, key=lambda x: x[1], reverse=True)\\n\\n# proximidade em valor absoluto\\n# resistances: pivot highs above last_close\\nresistances = [h for (d,h) in pivots_high if h > last_close]\\nsupports = [l for (d,l) in pivots_low if l < last_close]\\n\\n# ordenar por proximidade ao pre\u00e7o\\nresistances_sorted = sorted(resistances, key=lambda x: abs(x-last_close))[:5]\\nsupports_sorted = sorted(supports, key=lambda x: abs(x-last_close))[:5]\\n\\n# incluir m\u00e9dias m\u00f3veis e bandas\\nresistances_sorted = resistances_sorted\\nsupports_sorted = supports_sorted\\n\\n# Print results\\nprint('\u00daltimo pre\u00e7o (close):', last_close)\\nprint('\u00daltimo volume:', int(vol_last))\\nprint('M\u00e9dia do volume (20):', int(vol_mean_20), 'mediana:', int(vol_median_20))\\nprint('\\\\nPivots high (todos):', pivots_high)\\nprint('\\\\nPivots low (todos):', pivots_low)\\nprint('\\\\nResist\u00eancias candidatas (pr\u00f3ximas):', resistances_sorted)\\nprint('Suportes candidatos (pr\u00f3ximos):', supports_sorted)\\n\\n# vamos tamb\u00e9m calcular tend\u00eancia das MM20 e MM50: inclina\u00e7\u00e3o linear regress\u00e3o dos \u00faltimos 10 dias\\nfrom scipy.stats import linregress\\nfor ma in ['MM20','MM50']:\\n    y = df[ma].dropna().tail(10).values\\n    x = list(range(len(y)))\\n    slope, intercept, r, p, se = linregress(x,y)\\n    print(f\\\"slope {ma}: {slope:.6f} (r={r:.3f})\\\")\\n\\n# retornos para uso na an\u00e1lise\\nout = {\\n    'last_close': float(last_close),\\n    'volume_last': int(vol_last),\\n    'vol_mean_20': int(vol_mean_20),\\n    'vol_median_20': int(vol_median_20),\\n    'resistances_sorted': resistances_sorted,\\n    'supports_sorted': supports_sorted,\\n    'mm20_slope': slope if 'slope' in locals() else None\\n}\\n\\nprint('\\\\nOutput dict:')\\nprint(out)\\n\\n# Print data head tail for verification\\nprint('\\\\n\u00daltimas linhas:')\\nprint(df.tail(10).to_string(index=False))\\n\\n# print to conform to tool requirement\\nprint('\\\\n--END--')\\n\"} }",
