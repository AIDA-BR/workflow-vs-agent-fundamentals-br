\\n# Local maxima/minima detection simple for order=3\\norder=3\\ncl = df['close'].values\\nmax_idx = []\\nmin_idx = []\\nfor i in range(order, len(cl)-order):\\n    window = cl[i-order:i+order+1]\\n    center = cl[i]\\n    if center == window.max():\\n        max_idx.append(i)\\n    if center == window.min():\\n        min_idx.append(i)\\n\\n# Get unique levels rounded\\nresistances = sorted(list(set([round(float(df.iloc[i]['close']),2) for i in max_idx])), reverse=True)[:6]\\nsupports = sorted(list(set([round(float(df.iloc[i]['close']),2) for i in min_idx])))[:6]\\n\\n# Add BB upper and MM200 to resistances, and BB lower and MM20 to supports\\nresistances += [round(bb_upper,2), round(mm200,2)]\\nsupports += [round(bb_lower,2), round(mm20,2)]\\n\\nout = {\\n    'avg_vol_20': avg_vol_20,\\n    'avg_vol_all': avg_vol_all,\\n    'pct_below_mm200': pct_below_mm200,\\n    'mm20_slope': round(slope,5),\\n    'mm20_slope_pct': slope_pct,\\n    'resistances': resistances,\\n    'supports': supports,\\n    'last': {\\n        'close': close,\\n        'mm20': mm20,\\n        'mm50': mm50,\\n        'mm200': mm200,\\n        'ema9': ema9,\\n        'ema21': ema21,\\n        'macd': macd,\\n        'macd_signal': macd_sig,\\n        'macd_hist': macd_hist,\\n        'bb_upper': bb_upper,\\n        'bb_mid': bb_mid,\\n        'bb_lower': bb_lower,\\n        'rsi': rsi,\\n        'volume': int(last['volume'])\\n    }\\n}\\n\\nprint(out)\\n\"} }",
