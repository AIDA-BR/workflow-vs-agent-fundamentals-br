lope = model.coef_[0]\\n# Slope per day as absolute and percent\\nslope_pct = slope / mm20_series.mean() * 100\\n\\n# Find local maxima/minima for resistance/support candidates\\nfrom scipy.signal import argrelextrema\\nclose_arr = df['close'].values\\n# local maxima\\nn=3\\nmax_idx = argrelextrema(close_arr, np.greater_equal, order=n)[0]\\nmin_idx = argrelextrema(close_arr, np.less_equal, order=n)[0]\\n\\nresistances = sorted(list(df.iloc[max_idx]['close'].round(2).unique()), reverse=True)[:5]\\nsupports = sorted(list(df.iloc[min_idx]['close'].round(2).unique()))[:5]\\n\\n# Also include psychological/indicator levels\\nresistances_extra = [round(float(bb_upper),2), round(float(mm200),2),]\\nsupports_extra = [round(float(bb_lower),2), round(float(mm20),2)]\\n\\n# Compose output\\nout = {\\n    'avg_vol_20': int(avg_vol_20),\\n    'avg_vol_all': int(avg_vol_all),\\n    'pct_below_mm200': round(pct_below_mm200,2),\\n    'mm20_slope': round(slope,5),\\n    'mm20_slope_pct': round(slope_pct,4),\\n    'resistances_detected': resistances + resistances_extra,\\n    'supports_detected': supports + supports_extra,\\n    'last': {\\n        'close': close,\\n        'mm20': mm20,\\n        'mm50': mm50,\\n        'mm200': mm200,\\n        'ema9': ema9,\\n        'ema21': ema21,\\n        'macd': macd,\\n        'macd_signal': macd_sig,\\n        'macd_hist': macd_hist,\\n        'bb_upper': bb_upper,\\n        'bb_mid': bb_mid,\\n        'bb_lower': bb_lower,\\n        'rsi': rsi,\\n        'volume': int(last['volume'])\\n    }\\n}\\n\\nprint(out)\\n\"} }",
