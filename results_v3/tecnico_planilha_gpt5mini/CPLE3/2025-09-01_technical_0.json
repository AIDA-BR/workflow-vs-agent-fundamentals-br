pos = (price - bb_mid) / (bb_width/2)  # standardized: -1 at lower band, +1 at upper band\\n\\n# Recent volatility: width average over last 20 days relative to mid\\nrecent_bb_width_mean = (df.BB_upper - df.BB_lower).tail(20).mean()\\n\\n# Volume: compare to 20-day mean\\nvol_mean_20 = df.volume.tail(20).mean()\\nvol_last_vs_mean = vol / vol_mean_20\\n\\n# Identify support/resistance: local minima/maxima in last 60 days (or whole series) pick prominent levels\\n# Simple approach: pick recent swing lows and highs (lowest lows and highest highs in windows)\\n\\n# Use rolling minima for supports: find local minima in low price where low <= previous and next\\nsupports = []\\nresistances = []\\nfor i in range(1,len(df)-1):\\n    if df.low.iloc[i] < df.low.iloc[i-1] and df.low.iloc[i] < df.low.iloc[i+1]:\\n        supports.append((df.date.iloc[i], df.low.iloc[i]))\\n    if df.high.iloc[i] > df.high.iloc[i-1] and df.high.iloc[i] > df.high.iloc[i+1]:\\n        resistances.append((df.date.iloc[i], df.high.iloc[i]))\\n\\n# Sort supports by date recent first and pick unique price levels\\nsupports_sorted = sorted(supports, key=lambda x: x[0], reverse=True)\\nresistances_sorted = sorted(resistances, key=lambda x: x[0], reverse=True)\\n\\n# Extract numeric levels, avoid duplicates within 0.02\\ndef unique_levels(items, n=3):\\n    levels = []\\n    for d,p in items:\\n        if all(abs(p - l) > 0.02 for l in levels):\\n            levels.append(round(p,3))\\n        if len(levels) >= n:\\n            break\\n    return levels\\n\\nsupport_levels = unique_levels(supports_sorted, 3)\\nresistance_levels = unique_levels(resistances_sorted, 3)\\n\\n# As fallback, use recent lows/highs\\nif len(support_levels) < 3:\\n    recent_lows = df.low.tail(30).nsmallest(3).round(3).tolist()\\n    support_levels = recent_lows\\nif len(resistance_levels) < 3:\\n    recent_highs = df.high.tail(30).nlargest(3).round(3).tolist()\\n    resistance_levels = recent_highs\\n\\n# Compose summary\\nsummary = {\\n    'price': price,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'mm200': mm200,\\n    'ema9': ema9,\\n    'ema21': ema21,\\n    'macd': macd,\\n    'macd_signal': macd_signal,\\n    'macd_hist': macd_hist,\\n    'bb_lower': bb_lower,\\n    'bb_mid': bb_mid,\\n    'bb_upper': bb_upper,\\n    'rsi': rsi,\\n    'volume': int(vol),\\n    'dist_mm20_pct': round(dist_mm20,3),\\n    'dist_mm50_pct': round(dist_mm50,3),\\n    'dist_mm200_pct': round(dist_mm200,3),\\n    'slope_mm20_per_day': round(slope_mm20,6),\\n    'slope_mm50_per_day': round(slope_mm50,6),\\n    'ema9_below_ema21': bool(ema9_below_ema21),\\n    'macd_below_signal': bool(macd_below_signal),\\n    'bb_pos': round(bb_pos,3),\\n    'bb_width_mean': round(recent_bb_width_mean,6),\\n    'vol_mean_20': int(vol_mean_20),\\n    'vol_last_vs_mean': round(vol_last_vs_mean,3),\\n    'supports': support_levels,\\n    'resistances': resistance_levels\\n}\\n\\nprint(summary)\\n\\n# Also print supports and resistances numeric lists\\nprint('\\\\nSupport levels:', support_levels)\\nprint('Resistance levels:', resistance_levels)\\n\\n# Print a simple recommendation logic\\n# Determine signal: if price > MM20 and EMA9 > EMA21 and MACD positive and MACD>signal and RSI>50 -> Alta\\n# If price < MM20 and EMA9 < EMA21 and MACD < signal and RSI<50 -> Baixa\\n# else Neutro\\nsignal = 'Neutro'\\nif price > mm20 and ema9 > ema21 and macd > macd_signal and rsi > 50:\\n    signal = 'Alta'\\nelif price < mm20 and ema9 < ema21 and macd < macd_signal and rsi < 50:\\n    signal = 'Baixa'\\n\\nprint('\\\\nSignal candidate:', signal)\\n\\n# Output numeric values for use in final message\\nresult = {'summary': summary, 'signal_candidate': signal}\\nprint('\\\\n---RESULT---')\\nprint(result)\\n\"} }",
