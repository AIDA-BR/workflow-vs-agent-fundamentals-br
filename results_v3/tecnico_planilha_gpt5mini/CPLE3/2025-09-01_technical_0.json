i+1]:\\n        res.append((recent.date.iloc[i], recent.high.iloc[i]))\\n\\nif len(res) < 3:\\n    highs = recent.high.nlargest(5).unique()\\n    ress = sorted(list(highs), reverse=True)[:3]\\nelse:\\n    sims = sorted(res, key=lambda x: x[0], reverse=True)\\n    seenr = []\\n    ress = []\\n    for d,p in sims:\\n        if all(abs(p - r) > 0.02 for r in seenr):\\n            seenr.append(p)\\n            ress.append(round(p,3))\\n        if len(ress) >= 3:\\n            break\\n\\nprint('supports chosen:', supps)\\nprint('resistances chosen:', ress)\\n\\n# Also compute nearest support under price\\nprice = df.close.iloc[-1]\\n# sort supports ascending and choose those < price\\nsupps_under = [s for s in supps if s < price]\\nif len(supps_under) == 0:\\n    supps_under = supps\\n\\nprint('supports under price:', supps_under)\\n\\n# Print the last values for reference\\nprint('\\\\nLast values:')\\nprint(df.iloc[-1][['close','MM20','MM50','MM200','EMA9','EMA21','MACD','MACD_signal','MACD_hist','BB_lower','BB_mid','BB_upper','RSI14','volume']])\\n\\nresult = {'supports': supps_under, 'resistances': ress}\\nprint('\\\\nRESULT:', result)\\n\"}}",
