9.41,9.49,9.24,9.49,3129310400,9.4265,9.0620,8.8592,9.4690,9.3838,0.1212,0.1511,-0.03,9.1383,9.4265,9.7147,58.4958\\n\\\"\\\"\\\"\\n\\n# leitura\\ndf = pd.read_csv(StringIO(data), parse_dates=['date'])\\ndf.set_index('date', inplace=True)\\n\\n# m\u00e9tricas de tend\u00eancia\\nlast = df.iloc[-1]\\nprice = last['close']\\nMM20 = last['MM20']\\nMM50 = last['MM50']\\nMM200 = last['MM200']\\nEMA9 = last['EMA9']\\nEMA21 = last['EMA21']\\nMACD = last['MACD']\\nMACD_signal = last['MACD_signal']\\nMACD_hist = last['MACD_hist']\\nBB_lower = last['BB_lower']\\nBB_mid = last['BB_mid']\\nBB_upper = last['BB_upper']\\nRSI = last['RSI14']\\nvol = last['volume']\\n\\n# verificar ordem das m\u00e9dias\\nma_order = ' > '.join([name for _,name in sorted([(MM20, 'MM20'),(MM50,'MM50'),(MM200,'MM200')], reverse=True)])\\n\\n# quando MM50 cruzou MM200 pela primeira vez (de baixo para cima)?\\n# Encontrar o primeiro \u00edndice em que MM50 > MM200 e no dia anterior MM50 <= MM200\\ncross_dates = []\\nfor i in range(1,len(df)):\\n    if pd.notna(df['MM200'].iloc[i]) and pd.notna(df['MM50'].iloc[i-1]):\\n        if (df['MM50'].iloc[i] > df['MM200'].iloc[i]) and (df['MM50'].iloc[i-1] <= df['MM200'].iloc[i-1]):\\n            cross_dates.append(df.index[i])\\n\\n# calcular inclina\u00e7\u00e3o da MM20 e MM50 nos \u00faltimos 20 preg\u00f5es (regress\u00e3o linear)\\nimport numpy as np\\nfrom sklearn.linear_model import LinearRegression\\n\\nfor span in [20,30]:\\n    sub = df['MM20'].dropna().iloc[-span:]\\n    X = np.arange(len(sub)).reshape(-1,1)\\n    y = sub.values.reshape(-1,1)\\n    model = LinearRegression().fit(X,y)\\n    slope_mm20 = model.coef_[0][0]\\n    if span==20:\\n        slope20 = slope_mm20\\n\\nsub50 = df['MM50'].dropna().iloc[-20:]\\nX50 = np.arange(len(sub50)).reshape(-1,1)\\ny50 = sub50.values.reshape(-1,1)\\nmodel50 = LinearRegression().fit(X50,y50)\\nslope50 = model50.coef_[0][0]\\n\\n# bandwidth (BB_upper - BB_lower) e compara\u00e7\u00e3o: m\u00e9dia 10 dias vs \u00faltima\\ndf['bb_width'] = df['BB_upper'] - df['BB_lower']\\nbb_last = df['bb_width'].iloc[-1]\\nbb_mean_10 = df['bb_width'].iloc[-10:].mean()\\n\\n# volume: m\u00e9dia 20 dias e \u00faltima\\nvol_mean_20 = df['volume'].iloc[-20:].mean()\\nvol_last = vol\\nvol_rel = vol_last / vol_mean_20\\n\\n# identificar piv\u00f4s locais (simples): m\u00e1ximos locais (fechamento maior que 3 vizinhos) e m\u00ednimos locais\\ncloses = df['close']\\nlocal_peaks = []\\nlocal_troughs = []\\nfor i in range(2,len(closes)-2):\\n    window = closes.iloc[i-2:i+3]\\n    center = closes.iloc[i]\\n    if center == window.max():\\n        local_peaks.append((closes.index[i], center))\\n    if center == window.min():\\n        local_troughs.append((closes.index[i], center))\\n\\n# listar \u00faltimos picos e vales relevantes\\nlast_peaks = local_peaks[-5:]\\nlast_troughs = local_troughs[-5:]\\n\\n# suportes/resist\u00eancias candidatos: BB_mid (MM20), MM50, locais\\nsupports = []\\nresistances = []\\n# imediato suporte: MM20\\nsupports.append(round(MM20,4))\\n# suporte m\u00e9dio: MM50\\nsupports.append(round(MM50,4))\\n# suporte longo: MM200\\nif not pd.isna(MM200):\\n    supports.append(round(MM200,4))\\n# resist\u00eancia imediata: BB_upper atual\\nresistances.append(round(BB_upper,4))\\n# resist\u00eancia: \u00faltimo pico de fechamento alto\\nif len(local_peaks)>0:\\n    # usar \u00faltimos peak valor\\n    resistances.append(round(local_peaks[-1][1],4))\\n# resist\u00eancia alternativa: m\u00e1ximo hist\u00f3rico no per\u00edodo\\nresistances.append(round(closes.max(),4))\\n\\n# preparar sa\u00edda resumida\\nsummary = {\\n    'price': price,\\n    'MA_order': ma_order,\\n    'MM50_cross_dates': cross_dates,\\n    'slope_MM20_per_day': slope20,\\n    'slope_MM50_per_day': slope50,\\n    'bb_last': bb_last,\\n    'bb_mean_10': bb_mean_10,\\n    'vol_last': vol_last,\\n    'vol_mean_20': vol_mean_20,\\n    'vol_rel': vol_rel,\\n    'last_peaks': last_peaks,\\n    'last_troughs': last_troughs,\\n    'supports': supports,\\n    'resistances': resistances,\\n    'indicators': {\\n        'MM20': MM20, 'MM50': MM50, 'MM200': MM200, 'EMA9': EMA9, 'EMA21': EMA21,\\n        'MACD': MACD, 'MACD_signal': MACD_signal, 'MACD_hist': MACD_hist,\\n        'BB_lower': BB_lower, 'BB_mid': BB_mid, 'BB_upper': BB_upper,\\n        'RSI14': RSI, 'volume': vol_last\\n    }\\n}\\n\\nprint('Resumo calculado:')\\nfrom pprint import pprint\\npprint(summary)\\n\\n# tamb\u00e9m imprimir local peaks/troughs de interesse\\nprint('\\\\n\u00daltimos picos (\u00faltimos 5):')\\nfor d,v in last_peaks:\\n    print(d.date(), v)\\nprint('\\\\n\u00daltimos vales (\u00faltimos 5):')\\nfor d,v in last_troughs:\\n    print(d.date(), v)\\n\\n# imprimir cross date\\nprint('\\\\nData crossover MM50>MM200 (quando ocorreu):', cross_dates)\\n\\n# imprimir algumas compara\u00e7\u00f5es r\u00e1pidas\\nprint(f\\\"Pre\u00e7o atual: {price}, MM20: {MM20}, MM50: {MM50}, MM200: {MM200}\\\")\\nprint(f\\\"EMA9: {EMA9}, EMA21: {EMA21}\\\")\\nprint(f\\\"MACD: {MACD}, Signal: {MACD_signal}, Hist: {MACD_hist}\\\")\\nprint(f\\\"RSI14: {RSI}\\\")\\nprint(f\\\"BB width last: {bb_last:.4f}, mean10: {bb_mean_10:.4f}\\\")\\nprint(f\\\"Volume last: {vol_last}, mean20: {vol_mean_20:.0f}, rel: {vol_rel:.2f}\\\")\\n\\n\\n# tamb\u00e9m gerar uma lista de indicadores para uso no relat\u00f3rio\\nind_list = []\\nind_list.append({'indicator':'MM20','reading':str(round(MM20,4)),'interpretation':''})\\nind_list.append({'indicator':'MM50','reading':str(round(MM50,4)),'interpretation':''})\\nind_list.append({'indicator':'MM200','reading':str(round(MM200,4)),'interpretation':''})\\nind_list.append({'indicator':'EMA9','reading':str(round(EMA9,4)),'interpretation':''})\\nind_list.append({'indicator':'EMA21','reading':str(round(EMA21,4)),'interpretation':''})\\nind_list.append({'indicator':'MACD','reading':str(round(MACD,4)),'interpretation':''})\\nind_list.append({'indicator':'MACD_signal','reading':str(round(MACD_signal,4)),'i