2.4107 12.4482 -0.0914 -0.1573 0.0659 11.9069 12.3285 12.7501 51.1002\\n2025-10-28 12.54 12.67 12.50 12.57 2166427100 12.3265 12.7066 14.2758 12.4426 12.4592 -0.0711 -0.1401 0.0690 11.9101 12.3265 12.7429 51.9115\\n2025-10-29 12.62 12.66 12.37 12.40 1866002400 12.3135 12.7080 14.2550 12.4340 12.4539 -0.0679 -0.1257 0.0577 11.9257 12.3135 12.7013 47.1389\\n2025-10-30 12.31 12.58 12.31 12.38 1707668200 12.3130 12.7070 14.2314 12.4232 12.4471 -0.0663 -0.1138 0.0475 11.9256 12.3130 12.7004 46.5962\\n2025-10-31 12.48 12.54 12.38 12.42 2328767900 12.3160 12.7000 14.2105 12.4226 12.4447 -0.0610 -0.1032 0.0422 11.9262 12.3160 12.7058 47.8885\\n2025-11-03 12.44 12.67 12.44 12.63 2660447400 12.3300 12.6906 14.1902 12.4641 12.4615 -0.0395 -0.0905 0.0510 11.9157 12.3300 12.7443 54.1603\\n'''\\n\\ndf = pd.read_csv(StringIO(data), sep=' ', parse_dates=['date'])\\n# Because whitespace delim uses multiple spaces, ensure columns align; but current reading works.\\n\\n# compute basic metrics\\nlast = df.iloc[-1]\\n\\nmetrics = {}\\nmetrics['date'] = last['date'].strftime('%Y-%m-%d')\\nmetrics['close'] = last['close']\\nmetrics['MM20'] = last['MM20']\\nmetrics['MM50'] = last['MM50']\\nmetrics['MM200'] = last['MM200']\\nmetrics['EMA9'] = last['EMA9']\\nmetrics['EMA21'] = last['EMA21']\\nmetrics['MACD'] = last['MACD']\\nmetrics['MACD_signal'] = last['MACD_signal']\\nmetrics['MACD_hist'] = last['MACD_hist']\\nmetrics['BB_lower'] = last['BB_lower']\\nmetrics['BB_mid'] = last['BB_mid']\\nmetrics['BB_upper'] = last['BB_upper']\\nmetrics['RSI14'] = last['RSI14']\\nmetrics['volume'] = last['volume']\\n\\n# distance to MAs\\nmetrics['dist_price_MM20'] = last['close'] - last['MM20']\\nmetrics['dist_price_MM50'] = last['close'] - last['MM50']\\nmetrics['dist_price_MM200'] = last['close'] - last['MM200']\\n\\n# slope of MM20 and MM50 over last 15 trading days using linear regression\\nfrom scipy.stats import linregress\\n\\nfor ma in ['MM20','MM50','MM200']:\\n    series = df[ma].dropna().tail(20).values\\n    x = list(range(len(series)))\\n    slope, intercept, rvalue, pvalue, stderr = linregress(x, series)\\n    metrics[f'{ma}_slope_per_day'] = slope\\n    metrics[f'{ma}_slope_pct_per_day'] = slope / series[-1] * 100\\n    metrics[f'{ma}_rvalue'] = rvalue\\n\\n# MACD histogram trend last 10 days\\nmacdh = df['MACD_hist'].tail(10).values\\nmetrics['macd_hist_trend'] = float(macdh[-1] - macdh[0])\\n\\n# RSI change last 5 days\\nrsi5 = df['RSI14'].tail(5).values\\nmetrics['rsi_change_5d'] = float(rsi5[-1] - rsi5[0])\\n\\n# Bollinger width\\nmetrics['bb_width'] = last['BB_upper'] - last['BB_lower']\\nmetrics['price_vs_bb_percent'] = (last['close'] - last['BB_lower']) / (metrics['bb_width']) * 100\\n\\n# volume vs 20-day average\\nvol20 = df['volume'].tail(20).mean()\\nmetrics['vol20_avg'] = float(vol20)\\nmetrics['volume_ratio_vs_20'] = float(last['volume'] / vol20)\\n\\n# find recent local supports (local minima) and resistances (local maxima) using simple method\\n# We'll find closes that are minima/maxima within a window of 5 days\\n\\ndf['close_shift_fwd'] = df['close'].shift(-1)\\ndf['close_shift_bwd'] = df['close'].shift(1)\\n\\nsupports = []\\nresistances = []\\nfor i in range(1, len(df)-1):\\n    if df.loc[i,'close'] < df.loc[i-1,'close'] and df.loc[i,'close'] < df.loc[i+1,'close']:\\n        supports.append((df.loc[i,'date'].strftime('%Y-%m-%d'), df.loc[i,'close']))\\n    if df.loc[i,'close'] > df.loc[i-1,'close'] and df.loc[i,'close'] > df.loc[i+1,'close']:\\n        resistances.append((df.loc[i,'date'].strftime('%Y-%m-%d'), df.loc[i,'close']))\\n\\n# sort unique by price\\nsup_prices = sorted({round(s[1],2) for s in supports})\\nres_prices = sorted({round(r[1],2) for r in resistances}, reverse=True)\\n\\nmetrics['supports'] = sup_prices[-5:] if len(sup_prices)>0 else []\\nmetrics['resistances'] = res_prices[:5] if len(res_prices)>0 else []\\n\\nimport json\\nprint(json.dumps(metrics, indent=2))\\n\"} }",
