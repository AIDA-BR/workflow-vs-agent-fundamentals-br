lse:\\n        break\\n\\n# RSI trend: change over 10 days\\nrsi_pct_10 = pct_change_over_days(df['RSI14'], 10)\\n\\n# Bollinger band position\\nbb_mid = last['BB_mid']\\nbb_upper = last['BB_upper']\\nbb_lower = last['BB_lower']\\nclose = last['close']\\nif not pd.isna(bb_upper) and not pd.isna(bb_mid):\\n    bb_range = bb_upper - bb_mid\\n    pos_from_mid = close - bb_mid\\n    pos_ratio = pos_from_mid / bb_range if bb_range != 0 else None\\nelse:\\n    pos_ratio = None\\n\\n# Volume vs 20-day average\\nvol_20_avg = df['volume'].tail(20).mean()\\nvol_last = last['volume']\\nvol_vs_avg = (vol_last - vol_20_avg) / vol_20_avg * 100\\n\\n# Identify support/resistance levels from recent swing lows/highs\\n# We'll take local minima/maxima in 'close' over last 60 days\\nfrom scipy.signal import argrelextrema\\nimport numpy as np\\narr = df['close'].values\\n# local minima and maxima with order=3\\nif len(arr) >= 7:\\n    minima_idx = argrelextrema(arr, np.less_equal, order=3)[0]\\n    maxima_idx = argrelextrema(arr, np.greater_equal, order=3)[0]\\nelse:\\n    minima_idx = []\\n    maxima_idx = []\\n\\n# collect last up to 3 supports (minima) and resistances (maxima)\\nsupports = sorted(list(df['close'].iloc[minima_idx].tail(5).unique())) if len(minima_idx)>0 else []\\nresistances = sorted(list(df['close'].iloc[maxima_idx].tail(5).unique()), reverse=True) if len(maxima_idx)>0 else []\\n\\n# Add moving averages as support/resistance candidates\\nsupports_candidates = supports.copy()\\nresistances_candidates = resistances.copy()\\n# include MM20 as support level\\nsupports_candidates.append(round(last['MM20'],4))\\n# include BB_lower as support\\nsupports_candidates.append(round(bb_lower,4))\\n# include MM50 and MM200 as resistances\\nresistances_candidates.append(round(last['MM50'],4))\\nresistances_candidates.append(round(last['MM200'],4))\\n# deduplicate and sort\\nsupports_candidates = sorted(list(dict.fromkeys(supports_candidates)))\\nresistances_candidates = sorted(list(dict.fromkeys(resistances_candidates)), reverse=True)\\n\\n# prepare results\\nresults = {\\n    'last_close': float(last['close']),\\n    'MM20_pct_20': mm20_pct_20,\\n    'MM50_pct_20': mm50_pct_20,\\n    'MM200_pct_20': mm200_pct_20,\\n    'ema_diff': float(ema_diff),\\n    'macd': float(macd),\\n    'macd_signal': float(macd_sig),\\n    'macd_hist': float(macd_hist),\\n    'hist_positive_streak': int(hist_positive_streak),\\n    'rsi': float(last['RSI14']),\\n    'rsi_pct_10': rsi_pct_10,\\n    'bb_pos_ratio': float(pos_ratio) if pos_ratio is not None else None,\\n    'vol_last': int(vol_last),\\n    'vol_20_avg': float(vol_20_avg),\\n    'vol_vs_avg_pct': float(vol_vs_avg),\\n    'supports_candidates': supports_candidates,\\n    'resistances_candidates': resistances_candidates\\n}\\n\\nprint(results)\\n\"} }",
