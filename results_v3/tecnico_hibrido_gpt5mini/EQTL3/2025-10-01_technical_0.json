lyfit\\nx = np.arange(len(df))\\nfor N in (20, 50):\\n    y = df['close'].tail(N).values\\n    xx = np.arange(N)\\n    coefs = polyfit(xx, y, 1)\\n    slope = coefs[1]\\n    globals()[f'slope_{N}'] = slope\\n\\n# find local minima/maxima\\ncl = df['close'].values\\npeaks = []\\ntroughs = []\\nfor i in range(1, len(cl)-1):\\n    if cl[i] > cl[i-1] and cl[i] > cl[i+1]:\\n        peaks.append((i, cl[i]))\\n    if cl[i] < cl[i-1] and cl[i] < cl[i+1]:\\n        troughs.append((i, cl[i]))\\n\\n# get last few peaks/troughs\\nlast_peaks = peaks[-4:]\\nlast_troughs = troughs[-4:]\\n\\n# cluster levels (round to 0.05)\\ndef cluster_levels(levels, round_to=0.05):\\n    rounded = [round(l/round_to)*round_to for l in levels]\\n    # unique sorted\\n    uniq = sorted(set(rounded))\\n    return uniq\\n\\npeak_levels = cluster_levels([p[1] for p in peaks])\\ntrough_levels = cluster_levels([t[1] for t in troughs])\\n\\n# Candidate supports: most recent troughs\\ncandidate_supports = sorted(set([t[1] for t in last_troughs] + [df['MM50'].iloc[-1], df['MM200'].iloc[-1]]))\\ncandidate_supports = sorted(candidate_supports)\\n# Candidate resistances: most recent peaks\\ncandidate_resistances = sorted(set([p[1] for p in last_peaks] + [df['BB_upper'].iloc[-1]]))\\ncandidate_resistances = sorted(candidate_resistances)\\n\\noutput = {\\n    'latest_close': float(latest['close']),\\n    'pct_price_mm20': round(pct_price_mm20, 2),\\n    'pct_price_mm50': round(pct_price_mm50, 2),\\n    'pct_price_mm200': round(pct_price_mm200, 2),\\n    'pct_price_ema9': round(pct_price_ema9, 2),\\n    'pct_price_ema21': round(pct_price_ema21, 2),\\n    'bb_pos': round(bb_pos, 3),\\n    'bb_width': round(bb_width, 3),\\n    'vol_last': int(vol_last),\\n    'vol_mean_20': int(vol_mean_20),\\n    'vol_mean_60': int(vol_mean_60),\\n    'macd': round(macd, 4),\\n    'macd_signal': round(macd_signal, 4),\\n    'macd_hist': round(macd_hist, 4),\\n    'rsi': round(rsi, 2),\\n    'slope_20': round(slope_20, 4),\\n    'slope_50': round(slope_50, 4),\\n    'last_peaks': last_peaks,\\n    'last_troughs': last_troughs,\\n    'candidate_supports': [round(x,3) for x in candidate_supports],\\n    'candidate_resistances': [round(x,3) for x in candidate_resistances],\\n    'peak_levels': peak_levels,\\n    'trough_levels': trough_levels\\n}\\n\\nprint(output)\\n\"} }",
