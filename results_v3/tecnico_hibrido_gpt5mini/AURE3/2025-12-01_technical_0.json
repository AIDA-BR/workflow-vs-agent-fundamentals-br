t(orient='list')\\n\\n# find recent swing highs and lows for support/resistance candidates\\n# we'll take local maxima/minima in 'close' over last 60 days\\ncl = df['close']\\nrecent60 = cl.iloc[-60:]\\n\\n# simple peaks and troughs\\nfrom scipy.signal import argrelextrema\\n\\narr = recent60.values\\n\\ntry:\\n    peaks_idx = argrelextrema(arr, np.greater_equal, order=3)[0]\\n    troughs_idx = argrelextrema(arr, np.less_equal, order=3)[0]\\n    peaks = recent60.iloc[peaks_idx].values\\n    troughs = recent60.iloc[troughs_idx].values\\nexcept Exception as e:\\n    peaks = []\\n    troughs = []\\n\\n# fallback: take highest and lowest closes in last 30 days\\nhighest_30 = cl.iloc[-30:].max()\\nlowest_30 = cl.iloc[-30:].min()\\nmetrics['highest_30'] = float(highest_30)\\nmetrics['lowest_30'] = float(lowest_30)\\n\\n# prepare outputs\\nmetrics, peaks.tolist()[:5], troughs.tolist()[:5]\\nprint(metrics)\\nprint('peaks (local maxima):', peaks.tolist()[:5])\\nprint('troughs (local minima):', troughs.tolist()[:5])\\n\\n# additional: moving averages order check\\norder = '>' if (metrics['MM20']>metrics['MM50']>metrics['MM200']) else 'mixed'\\nprint('MA order (20>50>200?):', order)\\n\\nprint('\\\\nSummary metrics for report:')\\nprint(f\\\"Close {metrics['last_close']}, MM20 {metrics['MM20']}, MM50 {metrics['MM50']}, MM200 {metrics['MM200']}\\\")\\nprint(f\\\"EMA9 {metrics['EMA9']} > EMA21 {metrics['EMA21']}?\\\", metrics['EMA9']>metrics['EMA21'])\\nprint('RSI:', metrics['RSI14'])\\nprint('MACD hist:', metrics['MACD_hist'])\\nprint('BB upper:', metrics['BB_upper'],'BB lower',metrics['BB_lower'])\\nprint('volume:', metrics['volume'])\\n\\n# compute average volume last 20 days and compare\\nmetrics['avg_vol_20'] = float(df['volume'].iloc[-20:].mean())\\nmetrics['vol_vs_avg20_pct'] = (metrics['volume'] - metrics['avg_vol_20'])/metrics['avg_vol_20']*100\\nprint('avg vol 20:', metrics['avg_vol_20'])\\nprint('vol vs avg20 pct:', metrics['vol_vs_avg20_pct'])\\n\\n# Return metric results for use in message\\nmetrics\\n\"} }",
