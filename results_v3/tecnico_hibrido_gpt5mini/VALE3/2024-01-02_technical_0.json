),'date']\\n\\nout = {\\n    'last_close': float(last['close']),\\n    'alignment': alignment,\\n    'slopes_per_day_last10': {k:(None if v is None else float(round(v,6))) for k,v in results.items()},\\n    'price_to_MM20': float(round(price_to_MM20,6)),\\n    'price_to_EMA9': float(round(price_to_EMA9,6)),\\n    'price_to_BB_upper': float(round(price_to_BB_upper,6)),\\n    'avg_vol_20': float(avg_vol_20),\\n    'volume_ratio': float(round(vol_ratio,3)),\\n    'macd_hist_recent_avg': float(round(hist_avg_recent,6)),\\n    'macd_hist_prev_avg': float(round(hist_avg_prev,6)),\\n    'recent_30_high': float(recent_high),\\n    'recent_30_high_date': str(recent_high_date.date()),\\n    'recent_30_close_high': float(recent_close_high),\\n    'recent_30_low': float(recent_low),\\n    'recent_30_low_date': str(recent_low_date.date())\\n}\\n\\nimport json\\nprint(json.dumps(out))\\n\"} }",
