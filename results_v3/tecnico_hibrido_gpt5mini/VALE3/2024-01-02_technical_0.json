ay (last 10 days):', results)\\nprint('price_to_MM20', price_to_MM20)\\nprint('price_to_EMA9', price_to_EMA9)\\nprint('price_to_BB_upper', price_to_BB_upper)\\nprint('avg_vol_20', avg_vol_20)\\nprint('volume_ratio', vol_ratio)\\nprint('macd_hist_recent_avg', hist_avg_recent, 'previous_avg', hist_avg_prev)\\nprint('last_RSI', last['RSI14'])\\nprint('MM20', last['MM20'], 'MM50', last['MM50'], 'MM200', last['MM200'])\\nprint('EMA9', last['EMA9'], 'EMA21', last['EMA21'])\\nprint('MACD', last['MACD'], 'MACD_signal', last['MACD_signal'], 'MACD_hist', last['MACD_hist'])\\nprint('BB', last['BB_lower'], last['BB_mid'], last['BB_upper'])\\n\\n# print some recent highs/lows for support/res\\nrecent_high = df['high'].tail(30).max()\\nrecent_high_date = df.loc[df['high'].tail(30).idxmax(),'date']\\nrecent_close_high = df['close'].tail(30).max()\\n\\nrecent_low = df['low'].tail(30).min()\\nrecent_low_date = df.loc[df['low'].tail(30).idxmin(),'date']\\n\\nprint('recent_30_high', recent_high, recent_high_date)\\nprint('recent_30_close_high', recent_close_high)\\nprint('recent_30_low', recent_low, recent_low_date)\\n\\n# output as dict\\nout = {\\n    'last_close': float(last['close']),\\n    'alignment': alignment,\\n    'slopes_per_day_last10': {k:float(round(v,6)) for k,v in results.items()},\\n    'price_to_MM20': float(round(price_to_MM20,6)),\\n    'price_to_EMA9': float(round(price_to_EMA9,6)),\\n    'price_to_BB_upper': float(round(price_to_BB_upper,6)),\\n    'avg_vol_20': float(avg_vol_20),\\n    'volume_ratio': float(round(vol_ratio,3)),\\n    'macd_hist_recent_avg': float(round(hist_avg_recent,6)),\\n    'macd_hist_prev_avg': float(round(hist_avg_prev,6)),\\n    'recent_30_high': float(recent_high),\\n    'recent_30_high_date': str(recent_high_date.date()),\\n    'recent_30_close_high': float(recent_close_high),\\n    'recent_30_low': float(recent_low),\\n    'recent_30_low_date': str(recent_low_date.date())\\n}\\n\\nimport json\\nprint(json.dumps(out))\\n\"} }",
