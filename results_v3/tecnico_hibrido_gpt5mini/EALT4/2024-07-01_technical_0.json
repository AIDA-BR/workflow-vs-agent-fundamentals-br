loc[troughs_recent].dt.strftime('%Y-%m-%d').tolist()\\n\\nsorted(peaks_recent_vals, reverse=True)[:5], sorted(troughs_recent_vals)[:5], peaks_recent_dates, troughs_recent_dates\\n\\n# Definir resist\u00eancias como os top 3 picos recentes e suportes como os 3 menores vales recentes\\nresistances = sorted(list(set([float(x) for x in sorted(peaks_recent_vals, reverse=True)[:3]])), reverse=True)\\nsupports = sorted(list(set([float(x) for x in sorted(troughs_recent_vals)[:3]])))\\n\\n# Se menos de 3, complete com hist\u00f3ricos\\nif len(resistances) < 3:\\n    top_peaks = sorted([float(x) for x in peak_vals], reverse=True)[:3]\\n    for p in top_peaks:\\n        if p not in resistances:\\n            resistances.append(p)\\n    resistances = sorted(resistances, reverse=True)\\nif len(supports) < 3:\\n    low_troughs = sorted([float(x) for x in trough_vals])[:3]\\n    for t in low_troughs:\\n        if t not in supports:\\n            supports.append(t)\\n    supports = sorted(supports)\\n\\n# Calcular m\u00e9dia e volume m\u00e9dio\\nmean_volume = df['volume'].mean()\\nlast_volume = df['volume'].iloc[-1]\\n\\n# Mostrar resultados\\noutput = {\\n    'resistances': resistances,\\n    'supports': supports,\\n    'mean_volume': float(mean_volume),\\n    'last_volume': int(last_volume),\\n    'latest_close': float(df['close'].iloc[-1]),\\n    'latest_MM20': float(df['MM20'].iloc[-1]),\\n    'latest_MM50': float(df['MM50'].iloc[-1]),\\n    'latest_MM200': float(df['MM200'].iloc[-1]),\\n    'EMA9': float(df['EMA9'].iloc[-1]),\\n    'EMA21': float(df['EMA21'].iloc[-1]),\\n    'MACD': float(df['MACD'].iloc[-1]),\\n    'MACD_signal': float(df['MACD_signal'].iloc[-1]),\\n    'MACD_hist': float(df['MACD_hist'].iloc[-1]),\\n    'BB_lower': float(df['BB_lower'].iloc[-1]),\\n    'BB_mid': float(df['BB_mid'].iloc[-1]),\\n    'BB_upper': float(df['BB_upper'].iloc[-1]),\\n    'RSI14': float(df['RSI14'].iloc[-1])\\n}\\n\\nprint(output)\\n\"} }",
