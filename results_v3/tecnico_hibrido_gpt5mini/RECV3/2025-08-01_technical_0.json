200'])/last['MM200']*100\\n\\n# find local supports (local minima) and resistances (local maxima) in close price\\n\\nfrom scipy.signal import argrelextrema\\nimport numpy as np\\n\\ncl=df['close']\\n# Use window 3 for local min/max detection\\nlocal_min_idx = argrelextrema(cl.values, np.less_equal, order=2)[0]\\nlocal_max_idx = argrelextrema(cl.values, np.greater_equal, order=2)[0]\\nlocal_mins = cl.iloc[local_min_idx]\\nlocal_maxs = cl.iloc[local_max_idx]\\n\\n# select most recent significant mins and maxs\\nsupports = list(sorted(local_mins.tail(5).values))\\nresistances = list(sorted(local_maxs.tail(5).values, reverse=True))\\n\\n# fallback: use recent closes for support\\nif len(supports)<3:\\n    supports = list(cl.tail(30).nsmallest(3).values)\\nif len(resistances)<3:\\n    resistances = list(cl.tail(60).nlargest(3).values)\\n\\n# Round supports/resistances to 2 decimals\\nsupports=[round(x,2) for x in supports][:3]\\nresistances=[round(x,2) for x in resistances][:3]\\n\\nsummary['supports']=supports\\nsummary['resistances']=resistances\\n\\nsummary, df.tail(10).to_dict(orient='index')\\n\"} }",
