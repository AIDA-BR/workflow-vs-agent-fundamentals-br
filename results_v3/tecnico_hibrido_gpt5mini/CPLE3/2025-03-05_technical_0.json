-0.0498 8.7119 9.0375 9.3631 47.0414\\n'''\\n\\ndf = pd.read_csv(StringIO(data), sep=' ')\\n# Convert types\\nfor col in ['open','high','low','close','volume','MM20','MM50','MM200','EMA9','EMA21','MACD','MACD_signal','MACD_hist','BB_lower','BB_mid','BB_upper','RSI14']:\\n    df[col] = pd.to_numeric(df[col])\\n\\n# Last row\\nlast = df.iloc[-1]\\n\\n# Compute distances and percentages\\nclose = last['close']\\nmm20 = last['MM20']\\nmm50 = last['MM50']\\nmm200 = last['MM200']\\nema9 = last['EMA9']\\nema21 = last['EMA21']\\nbb_low = last['BB_lower']\\nbb_mid = last['BB_mid']\\nbb_up = last['BB_upper']\\nmacd = last['MACD']\\nsignal = last['MACD_signal']\\nhist = last['MACD_hist']\\nrsi = last['RSI14']\\nvol = last['volume']\\n\\n# pct differences\\npct_vs_mm20 = (close - mm20) / mm20 * 100\\npct_vs_mm50 = (close - mm50) / mm50 * 100\\npct_vs_mm200 = (close - mm200) / mm200 * 100\\npct_vs_bb_mid = (close - bb_mid) / bb_mid * 100\\npct_vs_bb_low = (close - bb_low) / bb_low * 100\\nbb_width = bb_up - bb_low\\n\\n# slope of MM20 over last 10 sessions\\nimport numpy as np\\nn=10\\nif len(df)>=n:\\n    y = df['MM20'].values[-n:]\\n    x = np.arange(n)\\n    slope = np.polyfit(x,y,1)[0]\\nelse:\\n    slope = None\\n\\n# slope mm50\\nif len(df)>=n:\\n    slope50 = np.polyfit(x,df['MM50'].values[-n:],1)[0]\\nelse:\\n    slope50 = None\\n\\n# slope mm200\\nif len(df)>=n:\\n    slope200 = np.polyfit(x,df['MM200'].values[-n:],1)[0]\\nelse:\\n    slope200 = None\\n\\n# volume average last 20\\navg_vol_20 = df['volume'].tail(20).mean()\\n\\n# recent MACD histogram trend\\nhist_recent = df['MACD_hist'].tail(5).values\\nhist_slope = np.polyfit(np.arange(len(hist_recent)), hist_recent, 1)[0]\\n\\n# identify recent swing high and low in closes (last 60 days)\\ncloses = df['close']\\nrecent = closes.tail(60)\\nrecent_high = recent.max()\\nrecent_low = recent.min()\\n\\noutput = {\\n    'close': close,\\n    'mm20': mm20,\\n    'mm50': mm50,\\n    'mm200': mm200,\\n    'ema9': ema9,\\n   