MA21']),\\n    'MACD': float(last['MACD']),\\n    'MACD_signal': float(last['MACD_signal']),\\n    'MACD_hist': float(last['MACD_hist']),\\n    'BB_lower': float(last['BB_lower']),\\n    'BB_mid': float(last['BB_mid']),\\n    'BB_upper': float(last['BB_upper']),\\n    'RSI14': float(last['RSI14'])\\n}\\n\\n# Short slopes: using numpy.polyfit for last 20 values\\n\\ndef slope(series):\\n    y = series.values\\n    x = np.arange(len(y))\\n    if len(y) < 2:\\n        return 0.0\\n    m = np.polyfit(x, y, 1)[0]\\n    return float(m)\\n\\nslope_MM20 = slope(df['MM20'].tail(20))\\nslope_MM50 = slope(df['MM50'].tail(20))\\nslope_MM200 = slope(df['MM200'].tail(20))\\n\\n# Volume average last 20 days\\nvol_avg_20 = int(df['volume'].tail(20).mean())\\n\\n# Find recent local supports/resistances: local minima/maxima with window 3\\ncloses = df['close'].values\\ndates = df['date'].values\\nlocal_mins = []\\nlocal_maxs = []\\nfor i in range(3, len(closes)-3):\\n    window = closes[i-3:i+4]\\n    if closes[i] == min(window):\\n        local_mins.append((dates[i], closes[i]))\\n    if closes[i] == max(window):\\n        local_maxs.append((dates[i], closes[i]))\\n\\n# Filter for recent pivots since 2024-03-01\\nlocal_mins_recent = [(d,c) for d,c in local_mins if d >= np.datetime64('2024-03-01')]\\nlocal_maxs_recent = [(d,c) for d,c in local_maxs if d >= np.datetime64('2024-03-01')]\\n\\n# Create support/resistance candidates\\nsupports = []\\nresistances = []\\n# immediate support: EMA9\\nsupports.append(round(metrics['EMA9'],4))\\n# add recent lows (unique)\\nrecent_lows = sorted(list(set([round(v,4) for d,v in local_mins_recent[:5]])))\\nfor v in recent_lows:\\n    if v not in supports:\\n        supports.append(v)\\n# Bollinger lower\\nsupports.append(round(metrics['BB_lower'],4))\\n\\n# Resistances: MM200, MM50, BB_upper, recent highs\\nresistances.append(round(metrics['MM200'],4))\\nresistances.append(round(metrics['MM50'],4))\\nresistances.append(round(metrics['BB_upper'],4))\\nrecent_highs = sorted(list(set([round(v,4) for d,v in local_maxs_recent[:5]])), reverse=True)\\nfor v in recent_highs:\\n    if v not in resistances:\\n        resistances.append(v)\\n\\n# trim supports/resistances to 5 each\\nsupports = supports[:5]\\nresistances = resistances[:5]\\n\\n# Build indicator readings list\\nindicator_readings = [\\n    ('MM20', f\\\"{metrics['MM20']:.4f}\\\", 'Pre\u00e7o pr\u00f3ximo \u00e0 MM20; MM20 em leve tend\u00eancia descendente nas \u00faltimas 20 sess\u00f5es.'),\\n    ('MM50', f\\\"{metrics['MM50']:.4f}\\\", 'MM50 acima do pre\u00e7o: resist\u00eancia de m\u00e9dio prazo.'),\\n    ('MM200', f\\\"{metrics['MM200']:.4f}\\\", 'MM200 tamb\u00e9m acima do pre\u00e7o; press\u00e3o de m\u00e9dio/longo prazo ainda presente.'),\\n    ('EMA9', f\\\"{metrics['EMA9']:.4f}\\\", 'EMA9 abaixo do pre\u00e7o (suporte curto); indica recupera\u00e7\u00e3o de curto prazo.'),\\n    ('EMA21', f\\\"{metrics['EMA21']:.4f}\\\", 'EMA21 muito pr\u00f3xima do pre\u00e7o; curto prazo neutro/levemente positivo.'),\\n    ('MACD', f\\\"{metrics['MACD']:.4f}\\\", 'MACD negativo, mas recentemente acima da linha de sinal (histograma positivo) \u2014 sinal de recupera\u00e7\u00e3o de momentum curto, convic\u00e7\u00e3o fraca.'),\\n    ('MACD_signal', f\\\"{metrics['MACD_signal']:.4f}\\\", 'Linha de sinal do MACD (refer\u00eancia).'),\\n    ('MACD_hist', f\\\"{metrics['MACD_hist']:.4f}\\\", 'Histograma pequeno e positivo: momentum comprador inicial, ainda fraco.'),\\n    ('BB_lower', f\\\"{metrics['BB_lower']:.4f}\\\", 'Banda inferior em 8.0100 \u2014 suporte de volatilidade abaixo do pre\u00e7o.'),\\n    ('BB_mid', f\\\"{metrics['BB_mid']:.4f}\\\", 'Banda m\u00e9dia (MM20) pr\u00f3xima ao pre\u00e7o; pre\u00e7o ligeiramente acima da m\u00e9dia.'),\\n    ('BB_upper', f\\\"{metrics['BB_upper']:.4f}\\\", 'Banda superior em 8.8250 \u2014 primeira resist\u00eancia clara.'),\\n    ('RSI14', f\\\"{metrics['RSI14']:.2f}\\\", 'RSI em ~48.8: neutro, sem condi\u00e7\u00e3o extrema; recuperou-se desde m\u00ednimos em abril.'),\\n    ('Volume', f\\\"{metrics['last_volume']}\\\", 'Volume do \u00faltimo preg\u00e3o moderado comparado aos picos de abril; movimento sem confirma\u00e7\u00e3o forte por volume.')\\n]\\n\\n# Print summary\\nprint('LAST_METRICS')\\nfor k,v in metrics.items():\\n    print(f\\\"{k}: {v}\\\")\\nprint('\\\\nSLOPES')\\nprint(f'slope_MM20(last20): {slope_MM20:.6f}')\\nprint(f'slope_MM50(last20): {slope_MM50:.6f}')\\nprint(f'slope_MM200(last20): {slope_MM200:.6f}')\\nprint('\\\\nVOLUME')\\nprint(f'vol_avg_20: {vol_avg_20}')\\nprint(f'last_volume: {metrics[\\\"last_volume\\\"]}')\\nprint('\\\\nSUPPORTS', supports)\\nprint('RESISTANCES', resistances)\\n\\n# Also print detected local pivots for reference\\nprint('\\\\nLOCAL_MINS_RECENT (since 2024-03-01):')\\nfor d,c in local_mins_recent:\\n    print(d.astype('M8[D]'), c)\\nprint('\\\\nLOCAL_MAXS_RECENT (since 2024-03-01):')\\nfor d,c in local_maxs_recent:\\n    print(d.astype('M8[D]'), c)\\n\\n# Return structured results for assistant use\\nresult = {\\n    'metrics': metrics,\\n    'slope_MM20': slope_MM20,\\n    'slope_MM50': slope_MM50,\\n    'slope_MM200': slope_MM200,\\n    'vol_avg_20': vol_avg_20,\\n    'supports': supports,\\n    'resistances': resistances,\\n    'indicator_readings': indicator_readings\\n}\\nprint('\\\\nEND_RESULT')\\nprint(result)\\n\"}}",
